---
// Кабінет адміністратора (Фаза 3, ТЗ §5.3) — внутрішній інструмент, не
// частина публічного багатомовного сайту. Окрема, легша i18n-система
// (src/i18n/admin.ts, лише uk/ru — на прохання користувача 2026-08-30
// "нужно русский") — без hreflang/SEO, це не публічна сторінка. Мова
// зберігається в cookie admin_locale (не в БД), перемикається посиланням
// внизу сайдбару. Окремий макет від BaseLayout.astro, який несе публічний
// header/footer/SEO-метадані.
import { adminLocales, getAdminLocale, admin } from '../i18n/admin';

interface Props {
	title: string;
	adminName?: string;
	activeNav?: 'overview' | 'guests' | 'rooms' | 'bookings';
}

const { title, adminName, activeNav } = Astro.props;
const locale = getAdminLocale(Astro.cookies.get('admin_locale')?.value);
const copy = admin[locale].nav;
const returnTo = encodeURIComponent(Astro.url.pathname + Astro.url.search);
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} — {copy.brandSub} {copy.brand}</title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<style>
			@import '@fontsource-variable/inter';

			:root {
				--bg-dark: #0b0d10;
				--surface-dark: #12151a;
				--surface-dark-2: #171b24;
				--border-dark: #262b36;
				--cream: #f5f5f3;
				--cream-muted: #c3c7cd;
				--muted: #8a8f98;
				--accent: #0072ce;
				--accent-ink: #f5f5f3;
				--bg-light: #f5f6f8;
				--text-dark: #14161a;
				--text-dark-muted: #5b6068;
				--border-light: #e2e5ea;
				--danger: #b3432f;
				--success: #3f7a4f;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				padding: 0;
			}

			body {
				font-family: 'Inter Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
				-webkit-font-smoothing: antialiased;
				background: var(--bg-light);
				color: var(--text-dark);
			}

			a {
				color: inherit;
			}

			.admin-shell {
				display: flex;
				min-height: 100vh;
			}

			.admin-sidebar {
				width: 15rem;
				flex-shrink: 0;
				background: var(--bg-dark);
				color: var(--cream);
				padding: 1.5rem 1rem;
				display: flex;
				flex-direction: column;
			}

			.admin-brand {
				font-weight: 700;
				font-size: 0.95rem;
				margin: 0 0 0.2rem;
				padding: 0 0.6rem;
			}

			.admin-brand-sub {
				font-size: 0.7rem;
				color: var(--cream-muted);
				margin: 0 0 1.5rem;
				padding: 0 0.6rem;
			}

			.admin-nav {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.15rem;
			}

			.admin-nav a {
				display: flex;
				align-items: center;
				gap: 0.65rem;
				padding: 0.55rem 0.7rem;
				border-radius: 0.5rem;
				text-decoration: none;
				color: var(--cream-muted);
				font-size: 0.88rem;
				font-weight: 500;
			}

			.admin-nav a svg {
				width: 17px;
				height: 17px;
				flex-shrink: 0;
			}

			.admin-nav a:hover,
			.admin-nav a.is-active {
				background: rgba(0, 114, 206, 0.15);
				color: var(--cream);
			}

			.admin-sidebar-foot {
				margin-top: auto;
				padding-top: 1rem;
				border-top: 1px solid var(--border-dark);
			}

			.admin-who {
				font-size: 0.78rem;
				color: var(--cream-muted);
				padding: 0 0.6rem;
				margin: 0 0 0.6rem;
			}

			.admin-lang-switch {
				display: flex;
				gap: 0.3rem;
				padding: 0 0.6rem;
				margin: 0 0 0.6rem;
			}

			.admin-lang-switch a {
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.03em;
				color: var(--cream-muted);
				text-decoration: none;
				padding: 0.15rem 0.4rem;
				border-radius: 0.3rem;
			}

			.admin-lang-switch a:hover {
				color: var(--cream);
			}

			.admin-lang-switch a.is-active {
				background: rgba(0, 114, 206, 0.2);
				color: var(--cream);
			}

			.admin-logout-btn {
				width: 100%;
				display: flex;
				align-items: center;
				gap: 0.65rem;
				text-align: left;
				background: none;
				border: none;
				color: var(--cream-muted);
				font: inherit;
				font-size: 0.85rem;
				font-weight: 500;
				padding: 0.55rem 0.7rem;
				border-radius: 0.5rem;
				cursor: pointer;
			}

			.admin-logout-btn svg {
				width: 17px;
				height: 17px;
				flex-shrink: 0;
			}

			.admin-logout-btn:hover {
				background: rgba(179, 67, 47, 0.15);
				color: #ff8f75;
			}

			.admin-main {
				flex: 1;
				min-width: 0;
				padding: 2rem 2.5rem;
			}

			@media (max-width: 760px) {
				.admin-shell {
					flex-direction: column;
				}

				.admin-sidebar {
					width: 100%;
					flex-direction: row;
					align-items: center;
					flex-wrap: wrap;
					gap: 0.5rem;
				}

				.admin-brand,
				.admin-brand-sub {
					display: none;
				}

				.admin-nav {
					flex-direction: row;
				}

				.admin-sidebar-foot {
					margin-top: 0;
					margin-left: auto;
					border-top: none;
					padding-top: 0;
				}

				.admin-who {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<div class="admin-shell">
			<aside class="admin-sidebar">
				<p class="admin-brand">{copy.brand}</p>
				<p class="admin-brand-sub">{copy.brandSub}</p>
				<nav>
					<ul class="admin-nav">
						<li>
							<a href="/admin" class={activeNav === 'overview' ? 'is-active' : ''}>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
									><rect x="3" y="3" width="7" height="9" rx="1.5"></rect><rect x="14" y="3" width="7" height="5" rx="1.5"></rect><rect
										x="14"
										y="12"
										width="7"
										height="9"
										rx="1.5"></rect><rect x="3" y="16" width="7" height="5" rx="1.5"></rect></svg
								>
								{copy.overview}
							</a>
						</li>
						<li>
							<a href="/admin/rooms" class={activeNav === 'rooms' ? 'is-active' : ''}>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
									><path d="M3 19V7a2 2 0 012-2h4a2 2 0 012 2v12"></path><path d="M13 19v-6a2 2 0 012-2h4a2 2 0 012 2v6"></path><path
										d="M3 19h18"></path><path d="M3 12h8"></path></svg
								>
								{copy.rooms}
							</a>
						</li>
						<li>
							<a href="/admin/bookings" class={activeNav === 'bookings' ? 'is-active' : ''}>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
									><rect x="3" y="4" width="18" height="17" rx="2"></rect><path d="M3 9h18"></path><path d="M8 2v4"></path><path d="M16 2v4"
									></path><path d="M8 14l2.5 2.5L16 11"></path></svg
								>
								{copy.bookings}
							</a>
						</li>
						<li>
							<a href="/admin/guests" class={activeNav === 'guests' ? 'is-active' : ''}>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
									><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"></path></svg
								>
								{copy.guests}
							</a>
						</li>
					</ul>
				</nav>
				<div class="admin-sidebar-foot">
					{adminName && <p class="admin-who">{adminName}</p>}
					<div class="admin-lang-switch">
						{adminLocales.map((l) => (
							<a href={`/admin/set-locale?locale=${l}&return=${returnTo}`} class={l === locale ? 'is-active' : ''}>
								{l.toUpperCase()}
							</a>
						))}
					</div>
					<form method="POST" action="/admin/logout">
						<button type="submit" class="admin-logout-btn">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
								><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path><path d="M16 17l5-5-5-5"></path><path d="M21 12H9"></path></svg
							>
							{copy.logout}
						</button>
					</form>
				</div>
			</aside>
			<main class="admin-main">
				<slot />
			</main>
		</div>
	</body>
</html>
