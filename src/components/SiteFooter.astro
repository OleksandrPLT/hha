---
import { landing } from '../i18n/landing';
import { privacy } from '../i18n/privacy';
import { terms } from '../i18n/terms';
import { property } from '../data/property';
import type { Locale } from '../i18n/locales';
import Logo from './Logo.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = landing[locale];
const privacyCopy = privacy[locale];
const termsCopy = terms[locale];
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<div class="site-footer__brand">
			<Logo size={34} />
			<span class="site-footer__brand-text">
				<span class="site-footer__brand-main">Hostel &amp; Hotel Apartments</span>
				<span class="site-footer__brand-sub">{property.propertyName} · {property.city}, {property.countryName}</span>
			</span>
		</div>

		<div class="site-footer__contact">
			<a href={`tel:${property.phoneE164}`}>{property.phoneDisplay}</a>
			<a href={`mailto:${property.email}`}>{property.email}</a>
		</div>

		<div class="site-footer__legal">
			<span>© {year} Hostel &amp; Hotel Apartments. {copy.footer.rights}</span>
			<a class="site-footer__privacy" href={`/${locale}/terms`}>{termsCopy.title}</a>
			<a class="site-footer__privacy" href={`/${locale}/privacy`}>{privacyCopy.title}</a>
			<a class="site-footer__credit" href="https://intech.org.ua" target="_blank" rel="noopener noreferrer">
				<svg viewBox="0 0 40 40" width="14" height="14" aria-hidden="true">
					<rect x="1" y="1" width="38" height="38" rx="10" stroke="currentColor" stroke-width="2" fill="none" />
					<rect x="17" y="10" width="6" height="20" rx="3" fill="currentColor" />
				</svg>
				<span>{copy.footer.poweredBy} Intech</span>
			</a>
		</div>
	</div>

	<div class="site-footer__imprint">
		<span>
			{property.legalEntityName} · {copy.footer.regCode} {property.legalEntityRegCode} · VAT {property.legalEntityVat} · {property.legalEntityAddress}
		</span>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--bg-dark);
		color: var(--cream-muted);
		border-top: 1px solid var(--border-dark);
	}

	.site-footer__inner {
		max-width: 72rem;
		margin: 0 auto;
		padding: 2.5rem 1.25rem 2rem;
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem 2rem;
		align-items: flex-start;
		justify-content: space-between;
	}

	.site-footer__brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.site-footer__brand-text {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.site-footer__brand-main {
		color: var(--cream);
		font-weight: 700;
	}

	.site-footer__brand-sub {
		font-size: 0.82rem;
	}

	.site-footer__contact {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		font-size: 0.88rem;
	}

	.site-footer__contact a {
		color: var(--cream-muted);
		text-decoration: none;
	}

	.site-footer__contact a:hover {
		color: var(--accent);
	}

	.site-footer__legal {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.5rem;
		font-size: 0.78rem;
		text-align: right;
	}

	.site-footer__privacy {
		color: var(--muted);
		text-decoration: none;
		font-size: 0.78rem;
	}

	.site-footer__privacy:hover {
		color: var(--cream-muted);
	}

	.site-footer__credit {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--muted);
		text-decoration: none;
	}

	.site-footer__credit:hover {
		color: var(--cream-muted);
	}

	.site-footer__imprint {
		border-top: 1px solid var(--border-dark);
		padding: 1rem 1.25rem 1.5rem;
		max-width: 72rem;
		margin: 0 auto;
	}

	.site-footer__imprint span {
		font-size: 0.72rem;
		color: var(--muted);
		line-height: 1.5;
	}

	@media (max-width: 640px) {
		.site-footer__inner {
			flex-direction: column;
		}

		.site-footer__legal {
			align-items: flex-start;
			text-align: left;
		}
	}
</style>
