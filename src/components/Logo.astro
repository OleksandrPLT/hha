---
// Логотип Hostel & Hotel Apartments — спрощена іконка (подушки + каркас
// ліжка + ніжки), адаптована з офіційного лого клієнта (2026-08-29,
// public/brand/logo-full.svg — повна версія з лампою/аркою/хвилею/написом,
// завелика для фавікону/шапки) для чіткості на малих розмірах.
// Кольори — точно як в офіційному лого: фон #0b0d10, білі елементи #f5f5f3,
// естонський синій акцент #0072CE.
interface Props {
	size?: number;
	class?: string;
}

const { size = 32, class: className } = Astro.props;
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 64 64"
	xmlns="http://www.w3.org/2000/svg"
	role="img"
	aria-label="Hostel & Hotel Apartments"
>
	<rect x="2" y="2" width="60" height="60" rx="16" fill="#0b0d10" />
	<rect x="15" y="21" width="14" height="11" rx="4" fill="#f5f5f3" />
	<rect x="35" y="21" width="14" height="11" rx="4" fill="#f5f5f3" />
	<rect x="9" y="34" width="46" height="14" rx="7" fill="#f5f5f3" />
	<line x1="14" y1="47" x2="10" y2="55" stroke="#0072CE" stroke-width="4" stroke-linecap="round" />
	<line x1="50" y1="47" x2="54" y2="55" stroke="#0072CE" stroke-width="4" stroke-linecap="round" />
</svg>
