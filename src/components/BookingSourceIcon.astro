---
// SVG-іконка джерела бронювання (обов'язково SVG, за проханням користувача
// 2026-08-30) — 'website' | 'phone' | 'email' | 'booking_com'. Мітка
// Booking.com — той самий inline-мark, що вже використовується в
// review-card на лендінгу (src/pages/[locale]/index.astro), для
// візуальної впізнаваності.
interface Props {
	source: string;
	size?: number;
}

const { source, size = 15 } = Astro.props;
---

{
	source === 'phone' ? (
		<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" />
		</svg>
	) : source === 'email' ? (
		<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<rect x="2" y="4" width="20" height="16" rx="2" />
			<path d="M2 7l10 6 10-6" />
		</svg>
	) : source === 'booking_com' ? (
		<svg width={size} height={size} viewBox="0 0 18 18" aria-hidden="true">
			<rect width="18" height="18" rx="4" fill="#003580" />
			<path
				d="M6.2 4.2h3.55c1.55 0 2.55.78 2.55 2.05 0 .9-.5 1.5-1.15 1.78.85.28 1.45.98 1.45 1.98 0 1.4-1.1 2.17-2.7 2.17H6.2V4.2Zm3.35 3.35c.7 0 1.15-.38 1.15-.98 0-.6-.45-.95-1.15-.95H7.85v1.93h1.7Zm.2 3.4c.75 0 1.25-.4 1.25-1.05 0-.63-.5-1.03-1.25-1.03H7.85v2.08h1.9Z"
				fill="#fff"
			/>
		</svg>
	) : (
		<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="12" cy="12" r="10" />
			<path d="M2 12h20" />
			<path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z" />
		</svg>
	)
}
