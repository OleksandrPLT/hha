---
// Невеликий власний набір лінійних іконок (без зовнішньої бібліотеки —
// економимо вагу сторінки) для секції "Amenities". id відповідає ключам
// у src/data/amenities.ts / src/i18n/amenities.ts.
interface Props {
	id: string;
}

const { id } = Astro.props;
---

<svg
	class="amenity-icon"
	width="20"
	height="20"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.75"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{
		id === 'wifi' && (
			<>
				<path d="M2 8.5a15 15 0 0 1 20 0" />
				<path d="M5 12a10 10 0 0 1 14 0" />
				<path d="M8.5 15.5a5 5 0 0 1 7 0" />
				<circle cx="12" cy="19" r="1" fill="currentColor" stroke="none" />
			</>
		)
	}
	{
		id === 'parking' && (
			<>
				<rect x="3" y="3" width="18" height="18" rx="3" />
				<path d="M9 16V8h3.5a2.5 2.5 0 0 1 0 5H9" />
			</>
		)
	}
	{
		id === 'minimarket' && (
			<>
				<path d="M6 8h12l-1 12H7L6 8Z" />
				<path d="M9 8V6a3 3 0 0 1 6 0v2" />
			</>
		)
	}
	{
		id === 'laundry' && (
			<>
				<rect x="4" y="3" width="16" height="18" rx="2" />
				<circle cx="12" cy="13" r="5" />
				<circle cx="12" cy="13" r="1.8" />
				<circle cx="7" cy="6" r="0.75" fill="currentColor" stroke="none" />
				<circle cx="10" cy="6" r="0.75" fill="currentColor" stroke="none" />
			</>
		)
	}
	{
		id === 'wakeup' && (
			<>
				<circle cx="12" cy="13" r="7" />
				<path d="M12 9.5v4l2.8 1.8" />
				<path d="M5 5 3 7M19 5l2 2" />
			</>
		)
	}
	{
		id === 'housekeeping' && (
			<>
				<path d="M12 3v3.5M12 17.5V21M4 12h3.5M16.5 12H20" />
				<path d="M6.8 6.8l2 2M15.2 15.2l2 2M6.8 17.2l2-2M15.2 8.8l2-2" />
			</>
		)
	}
	{
		id === 'breakfast' && (
			<>
				<path d="M5 9h11v6a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4V9Z" />
				<path d="M16 10.5h1.2a2.3 2.3 0 0 1 0 4.5H16" />
				<path d="M8 4.2c0 1-1 1-1 2M12 4.2c0 1-1 1-1 2" />
			</>
		)
	}
	{
		id === 'kitchen' && (
			<>
				<path d="M4 11h16v3a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5v-3Z" />
				<path d="M2.5 11h19" />
				<path d="M9.5 7h5" />
				<circle cx="12" cy="4.7" r="1" />
			</>
		)
	}
	{
		id === 'fridge' && (
			<>
				<rect x="6" y="2" width="12" height="20" rx="2" />
				<path d="M6 9.5h12" />
				<path d="M9 4.5v3M9 12.5v3" />
			</>
		)
	}
	{
		id === 'microwave' && (
			<>
				<rect x="2" y="6" width="20" height="13" rx="2" />
				<rect x="5" y="9" width="10" height="7" rx="1" />
				<circle cx="18.3" cy="10.5" r="0.8" fill="currentColor" stroke="none" />
				<path d="M17 14.5h3" />
			</>
		)
	}
	{
		id === 'pets' && (
			<>
				<circle cx="7.5" cy="8.5" r="1.5" />
				<circle cx="12" cy="6.5" r="1.5" />
				<circle cx="16.5" cy="8.5" r="1.5" />
				<path d="M8 14a4 4 0 0 1 8 0c0 2.3-2 3-4 3s-4-.7-4-3Z" />
			</>
		)
	}
	{
		id === 'checkIn' && (
			<>
				<path d="M12.5 4H6.5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h6" />
				<path d="M11 12h10" />
				<path d="M17 8l4 4-4 4" />
			</>
		)
	}
	{
		id === 'checkOut' && (
			<>
				<path d="M11.5 4h6a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-6" />
				<path d="M13 12H3" />
				<path d="M7 8l-4 4 4 4" />
			</>
		)
	}
	{
		id === 'noParties' && (
			<>
				<path d="M6.5 20.5L16 11l2.5 2.5L9 23" />
				<path d="M13.5 8l1.3-1.3M16.5 11l1.3-1.3M10.5 6l0.8 1.6M19 14l1.8 0.9" />
				<line x1="3" y1="3" x2="21" y2="21" />
			</>
		)
	}
	{
		id === 'noSmoking' && (
			<>
				<path d="M2 16h13v3H2z" />
				<path d="M16 14v5M19 14v5" />
				<line x1="3" y1="3" x2="21" y2="21" />
			</>
		)
	}
	{
		id === 'visa' && (
			<>
				<rect x="1" y="4" width="22" height="16" rx="3" fill="#fff" stroke="#1A1F71" stroke-width="1.5" />
				<text x="12" y="15.2" text-anchor="middle" font-size="7.5" font-weight="800" font-style="italic" fill="#1A1F71" stroke="none" font-family="Arial, sans-serif">
					VISA
				</text>
			</>
		)
	}
	{
		id === 'mastercard' && (
			<>
				<rect x="1" y="4" width="22" height="16" rx="3" fill="#fff" stroke="none" />
				<circle cx="9.5" cy="12" r="5.2" fill="#EB001B" stroke="none" />
				<circle cx="14.5" cy="12" r="5.2" fill="#F79E1B" stroke="none" fill-opacity="0.85" />
			</>
		)
	}
	{
		id === 'amex' && (
			<>
				<rect x="1" y="4" width="22" height="16" rx="3" fill="#006FCF" stroke="none" />
				<text x="12" y="15" text-anchor="middle" font-size="6" font-weight="800" fill="#fff" stroke="none" font-family="Arial, sans-serif">
					AMEX
				</text>
			</>
		)
	}
	{
		id === 'maestro' && (
			<>
				<rect x="1" y="4" width="22" height="16" rx="3" fill="#fff" stroke="none" />
				<circle cx="9.5" cy="12" r="5.2" fill="#EB001B" stroke="none" />
				<circle cx="14.5" cy="12" r="5.2" fill="#0099DF" stroke="none" fill-opacity="0.85" />
			</>
		)
	}
	{
		id === 'nfc' && (
			<>
				<path d="M7 8a6 6 0 0 1 0 8" />
				<path d="M10.5 5.3a10 10 0 0 1 0 13.4" />
				<circle cx="3.4" cy="12" r="1.2" fill="currentColor" stroke="none" />
			</>
		)
	}
	{
		id === 'cash' && (
			<>
				<rect x="2" y="6" width="20" height="12" rx="2" />
				<circle cx="12" cy="12" r="2.6" />
				<path d="M5 9v.01M19 15v.01" />
			</>
		)
	}
	{id === 'noAc' && <path d="M12 2v20M4.2 7l15.6 10M19.8 7 4.2 17M9 4l3-2 3 2M9 20l3 2 3-2M4.2 10l-2-1v3.5M19.8 10l2-1v3.5M4.2 14l-2 1v-3.5M19.8 14l2 1v-3.5" />}
	{
		id === 'noPool' && (
			<>
				<path d="M2 8.5c1.4 1.4 2.8 1.4 4.2 0s2.8-1.4 4.2 0 2.8 1.4 4.2 0 2.8-1.4 4.2 0" />
				<path d="M2 13c1.4 1.4 2.8 1.4 4.2 0s2.8-1.4 4.2 0 2.8 1.4 4.2 0 2.8-1.4 4.2 0" />
				<path d="M2 17.5c1.4 1.4 2.8 1.4 4.2 0s2.8-1.4 4.2 0 2.8 1.4 4.2 0 2.8-1.4 4.2 0" />
			</>
		)
	}
	{
		id === 'noFitness' && (
			<>
				<path d="M2.5 10.5v3M21.5 10.5v3" />
				<rect x="4.5" y="9" width="3" height="6" rx="1" />
				<rect x="16.5" y="9" width="3" height="6" rx="1" />
				<path d="M7.5 12h9" />
			</>
		)
	}
	{
		id === 'noWheelchair' && (
			<>
				<circle cx="9.5" cy="17" r="4" />
				<circle cx="9.5" cy="4.3" r="1.3" fill="currentColor" stroke="none" />
				<path d="M9.5 6v6h6.5l3 6" />
			</>
		)
	}
	{
		id === 'sharedShowers' && (
			<>
				<path d="M6 8a6 6 0 0 1 12 0" />
				<path d="M4 8h16" />
				<path d="M8 12.5v1M12 12.5v1M16 12.5v1M8 16.5v1M12 16.5v1M16 16.5v1M10 20.5v1M14 20.5v1" />
			</>
		)
	}
	{
		id === 'privateBathroom' && (
			<>
				<path d="M4 12h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-3Z" />
				<path d="M2 12h2" />
				<path d="M7 12V6.3A2 2 0 0 1 10.3 5" />
				<path d="M9 19.5v1.5M15 19.5v1.5" />
			</>
		)
	}
	{
		id === 'languages' && (
			<>
				<circle cx="12" cy="12" r="9" />
				<path d="M3 12h18" />
				<path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18" />
			</>
		)
	}
</svg>

<style>
	/* Стилі саме тут, а не в батьківській сторінці — Astro скоуп-CSS не
	   "пробиває" межу дочірнього компонента, тож правило на .amenity-icon
	   у src/pages/[locale]/index.astro на цей <svg> не діяло. */
	.amenity-icon {
		flex-shrink: 0;
		color: var(--accent);
	}
</style>
