---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '../../../db/client';
import { admins, promotions, rooms } from '../../../db/schema';
import { eq, asc } from 'drizzle-orm';
import { getAdminLocale, admin as adminCopy } from '../../../i18n/admin';

export const prerender = false;

const adminId = await Astro.session?.get('adminId');
if (!adminId) {
	return Astro.redirect('/admin/login');
}
const currentAdmin = db.select().from(admins).where(eq(admins.id, adminId)).get();
if (!currentAdmin) {
	return Astro.redirect('/admin/login');
}

const locale = getAdminLocale(Astro.cookies.get('admin_locale')?.value);
const copy = adminCopy[locale].promotionEdit;

const idParam = Astro.params.id;
const isNew = idParam === 'new';
const promoId = isNew ? null : Number(idParam);
if (!isNew && !Number.isInteger(promoId)) {
	return Astro.redirect('/admin/promotions');
}

const activeRooms = db.select().from(rooms).orderBy(asc(rooms.sortOrder)).all();
function roomTitle(room: (typeof activeRooms)[number]): string {
	try {
		const parsed = JSON.parse(room.titles) as Record<string, string>;
		return parsed.en ?? room.slug;
	} catch {
		return room.slug;
	}
}

let promo = isNew ? null : db.select().from(promotions).where(eq(promotions.id, promoId!)).get() ?? null;
if (!isNew && !promo) {
	return Astro.redirect('/admin/promotions');
}

let error = '';
const updatedNotice = Astro.url.searchParams.get('updated') === '1';

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = String(form.get('action') || 'save');

	if (action === 'delete' && !isNew) {
		db.delete(promotions).where(eq(promotions.id, promoId!)).run();
		return Astro.redirect('/admin/promotions');
	}

	if (action === 'save') {
		const label = String(form.get('label') || '').trim();
		const roomIdRaw = String(form.get('roomId') || '');
		const roomId = roomIdRaw === '' ? null : Number(roomIdRaw);
		const discountType = String(form.get('discountType') || 'percent');
		const discountInput = Number(form.get('discountValue'));
		const startDate = String(form.get('startDate') || '');
		const endDate = String(form.get('endDate') || '');
		const isActive = form.get('isActive') === 'on';

		// discountValue зберігається в БД: для 'percent' — ціле число 1-100,
		// для 'fixed' — ЦЕНТИ (той самий підхід, що й ціни номерів), тоді як
		// адмін вводить євро з десятковими — тому конвертуємо тут.
		const discountValue = discountType === 'fixed' ? Math.round(discountInput * 100) : Math.round(discountInput);

		if (!label || !Number.isFinite(discountInput) || discountInput <= 0 || !startDate || !endDate) {
			error = copy.errorRequired;
		} else if (endDate < startDate) {
			error = copy.errorDates;
		} else if (isNew) {
			const inserted = db.insert(promotions).values({ label, roomId, discountType, discountValue, startDate, endDate, isActive }).run();
			return Astro.redirect(`/admin/promotions/${inserted.lastInsertRowid}`);
		} else {
			db.update(promotions).set({ label, roomId, discountType, discountValue, startDate, endDate, isActive }).where(eq(promotions.id, promoId!)).run();
			return Astro.redirect(`/admin/promotions/${promoId}?updated=1`);
		}
	}

	promo = isNew ? null : db.select().from(promotions).where(eq(promotions.id, promoId!)).get() ?? null;
}
---

<AdminLayout title={isNew ? copy.titleNew : promo?.label ?? ''} adminName={currentAdmin.fullName} activeNav="promotions">
	<a href="/admin/promotions" class="back-link">{copy.back}</a>
	<h1>{isNew ? copy.titleNew : promo?.label}</h1>

	{updatedNotice && <p class="notice notice--success">{copy.savedNotice}</p>}
	{error && <p class="notice notice--error">{error}</p>}

	<form method="POST" class="promo-form">
		<input type="hidden" name="action" value="save" />
		<label>
			{copy.label}
			<input type="text" name="label" required placeholder={copy.labelPlaceholder} value={promo?.label ?? ''} />
		</label>

		<label>
			{copy.room}
			<select name="roomId">
				<option value="" selected={!promo?.roomId}>{copy.allRoomsOption}</option>
				{activeRooms.map((r) => (
					<option value={r.id} selected={promo?.roomId === r.id}>
						{roomTitle(r)}
					</option>
				))}
			</select>
		</label>

		<div class="field-row">
			<label>
				{copy.discountType}
				<select name="discountType" id="discountType">
					<option value="percent" selected={!promo || promo.discountType === 'percent'}>{copy.discountTypePercent}</option>
					<option value="fixed" selected={promo?.discountType === 'fixed'}>{copy.discountTypeFixed}</option>
				</select>
			</label>
			<label>
				{copy.discountValue}
				<input
					type="number"
					step="0.01"
					min="0.01"
					name="discountValue"
					required
					value={promo ? (promo.discountType === 'fixed' ? promo.discountValue / 100 : promo.discountValue) : ''}
				/>
			</label>
		</div>
		<p class="field-note" id="discount-hint">{!promo || promo.discountType === 'percent' ? copy.discountValueHintPercent : copy.discountValueHintFixed}</p>

		<div class="field-row">
			<label>
				{copy.startDate}
				<input type="date" name="startDate" required value={promo?.startDate ?? ''} />
			</label>
			<label>
				{copy.endDate}
				<input type="date" name="endDate" required value={promo?.endDate ?? ''} />
			</label>
		</div>

		<label class="checkbox-row">
			<input type="checkbox" name="isActive" checked={promo?.isActive ?? true} />
			<span>{copy.isActive}</span>
		</label>

		<button type="submit" class="btn-primary">{isNew ? copy.createBtn : copy.saveBtn}</button>
	</form>

	{
		!isNew && (
			<form method="POST" class="delete-form" onsubmit={`return confirm(${JSON.stringify(copy.confirmDelete)})`}>
				<input type="hidden" name="action" value="delete" />
				<button type="submit" class="btn-danger">{copy.deleteBtn}</button>
			</form>
		)
	}

	<script define:vars={{ hintPercent: copy.discountValueHintPercent, hintFixed: copy.discountValueHintFixed }}>
		const typeSelect = document.getElementById('discountType');
		const hint = document.getElementById('discount-hint');
		typeSelect?.addEventListener('change', () => {
			hint.textContent = typeSelect.value === 'fixed' ? hintFixed : hintPercent;
		});
	</script>

	<style>
		.back-link {
			display: inline-block;
			margin-bottom: 0.75rem;
			font-size: 0.82rem;
			color: var(--text-dark-muted);
			text-decoration: none;
		}

		.back-link:hover {
			color: var(--accent);
		}

		h1 {
			margin: 0 0 1rem;
			font-size: 1.4rem;
			font-weight: 700;
		}

		.notice {
			border-radius: 0.6rem;
			padding: 0.65rem 0.9rem;
			margin: 0 0 1rem;
			font-size: 0.85rem;
			max-width: 32rem;
		}

		.notice--success {
			background: rgba(63, 122, 79, 0.1);
			color: var(--success);
			border: 1px solid rgba(63, 122, 79, 0.3);
		}

		.notice--error {
			background: rgba(179, 67, 47, 0.1);
			color: var(--danger);
			border: 1px solid rgba(179, 67, 47, 0.3);
		}

		.promo-form {
			display: flex;
			flex-direction: column;
			gap: 1rem;
			background: #fff;
			border: 1px solid var(--border-light);
			border-radius: 0.85rem;
			padding: 1.5rem;
			max-width: 32rem;
		}

		.promo-form label {
			display: flex;
			flex-direction: column;
			gap: 0.35rem;
			font-size: 0.85rem;
			font-weight: 600;
			color: var(--text-dark);
		}

		.promo-form input,
		.promo-form select {
			font: inherit;
			font-weight: 400;
			padding: 0.55rem 0.7rem;
			border-radius: 0.5rem;
			border: 1px solid var(--border-light);
			background: #fff;
			color: var(--text-dark);
		}

		.field-row {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 1rem;
		}

		.field-note {
			margin: -0.6rem 0 0;
			font-size: 0.75rem;
			color: var(--text-dark-muted);
		}

		.checkbox-row {
			flex-direction: row !important;
			align-items: center;
			gap: 0.5rem;
		}

		.btn-primary {
			align-self: flex-start;
			font: inherit;
			font-size: 0.85rem;
			font-weight: 700;
			padding: 0.6rem 1.2rem;
			border-radius: 0.5rem;
			border: none;
			background: var(--bg-dark);
			color: var(--cream);
			cursor: pointer;
		}

		.delete-form {
			margin-top: 1rem;
			max-width: 32rem;
		}

		.btn-danger {
			font: inherit;
			font-size: 0.82rem;
			font-weight: 700;
			padding: 0.55rem 1rem;
			border-radius: 0.5rem;
			border: 1px solid rgba(179, 67, 47, 0.4);
			background: #fff;
			color: var(--danger);
			cursor: pointer;
		}

		@media (max-width: 560px) {
			.field-row {
				grid-template-columns: 1fr;
			}
		}
	</style>
</AdminLayout>
