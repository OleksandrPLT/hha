---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '../../../db/client';
import { admins, checkinCards } from '../../../db/schema';
import { eq, desc } from 'drizzle-orm';
import { getAdminLocale, admin as adminCopy } from '../../../i18n/admin';
import { formatCheckinCode } from '../../../lib/memberCard';

export const prerender = false;

const adminId = await Astro.session?.get('adminId');
if (!adminId) {
	return Astro.redirect('/admin/login');
}
const currentAdmin = db.select().from(admins).where(eq(admins.id, adminId)).get();
if (!currentAdmin) {
	return Astro.redirect('/admin/login');
}

const locale = getAdminLocale(Astro.cookies.get('admin_locale')?.value);
const copy = adminCopy[locale].checkinList;

const allCards = db.select().from(checkinCards).orderBy(desc(checkinCards.createdAt)).all();
---

<AdminLayout title={copy.title} adminName={currentAdmin.fullName} activeNav="checkin">
	<h1>{copy.title}</h1>
	<p class="page-subtitle">{copy.subtitle}</p>

	{
		allCards.length === 0 ? (
			<p class="empty-note">{copy.empty}</p>
		) : (
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>{copy.colId}</th>
							<th>{copy.colName}</th>
							<th>{copy.colStay}</th>
							<th>{copy.colDates}</th>
							<th>{copy.colVerified}</th>
						</tr>
					</thead>
					<tbody>
						{allCards.map((c) => (
							<tr>
								<td><a href={`/admin/checkin/${c.id}`}>{formatCheckinCode(c.id)}</a></td>
								<td>
									{c.firstName} {c.lastName}
								</td>
								<td class="mono">
									{c.arrivalDate} → {c.departureDate}
								</td>
								<td class="mono">{c.createdAt}</td>
								<td>
									<span class={c.verifiedAt ? 'status-badge status-badge--active' : 'status-badge'}>
										{c.verifiedAt ? copy.verifiedYes : copy.verifiedNo}
									</span>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		)
	}

	<style>
		h1 {
			margin: 0;
			font-size: 1.4rem;
			font-weight: 700;
		}

		.page-subtitle {
			margin: 0 0 1.25rem;
			font-size: 0.85rem;
			color: var(--text-dark-muted);
			max-width: 40rem;
		}

		.empty-note {
			color: var(--text-dark-muted);
			font-size: 0.88rem;
		}

		.table-wrap {
			background: #fff;
			border: 1px solid var(--border-light);
			border-radius: 0.85rem;
			overflow-x: auto;
		}

		table {
			width: 100%;
			border-collapse: collapse;
			font-size: 0.85rem;
		}

		th,
		td {
			text-align: left;
			padding: 0.65rem 1rem;
			white-space: nowrap;
			vertical-align: middle;
		}

		.mono {
			font-size: 0.78rem;
			color: var(--text-dark-muted);
		}

		thead th {
			font-size: 0.72rem;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			color: var(--text-dark-muted);
			border-bottom: 1px solid var(--border-light);
		}

		tbody tr:not(:last-child) td {
			border-bottom: 1px solid var(--border-light);
		}

		tbody a {
			color: var(--accent);
			font-weight: 600;
			text-decoration: none;
		}

		tbody a:hover {
			text-decoration: underline;
		}

		.status-badge {
			border-radius: 999px;
			padding: 0.25rem 0.7rem;
			font-size: 0.72rem;
			font-weight: 700;
			background: var(--border-light);
			color: var(--text-dark-muted);
		}

		.status-badge--active {
			background: rgba(63, 122, 79, 0.12);
			color: var(--success);
		}
	</style>
</AdminLayout>
