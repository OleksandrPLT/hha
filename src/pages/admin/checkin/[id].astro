---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '../../../db/client';
import { admins, checkinCards } from '../../../db/schema';
import { eq } from 'drizzle-orm';
import { getAdminLocale, admin as adminCopy } from '../../../i18n/admin';
import { formatCheckinCode } from '../../../lib/memberCard';

export const prerender = false;

const adminId = await Astro.session?.get('adminId');
if (!adminId) {
	return Astro.redirect('/admin/login');
}
const currentAdmin = db.select().from(admins).where(eq(admins.id, adminId)).get();
if (!currentAdmin) {
	return Astro.redirect('/admin/login');
}

const locale = getAdminLocale(Astro.cookies.get('admin_locale')?.value);
const copy = adminCopy[locale].checkinDetail;

const cardId = Number(Astro.params.id);
if (!Number.isInteger(cardId)) {
	return Astro.redirect('/admin/checkin');
}
let card = db.select().from(checkinCards).where(eq(checkinCards.id, cardId)).get();
if (!card) {
	return Astro.redirect('/admin/checkin');
}

let notice = '';

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const roomBedNumber = String(form.get('roomBedNumber') || '').trim();
	const documentType = String(form.get('documentType') || '');
	const documentTypeOther = String(form.get('documentTypeOther') || '').trim();
	const documentNumber = String(form.get('documentNumber') || '').trim();

	db.update(checkinCards)
		.set({
			roomBedNumber: roomBedNumber || null,
			documentType: documentType || null,
			documentTypeOther: documentTypeOther || null,
			documentNumber: documentNumber || null,
			receptionistId: adminId,
			verifiedAt: new Date().toISOString().replace('T', ' ').slice(0, 19),
		})
		.where(eq(checkinCards.id, cardId))
		.run();

	notice = copy.notice;
	card = db.select().from(checkinCards).where(eq(checkinCards.id, cardId)).get()!;
}

const receptionist = card.receptionistId ? db.select().from(admins).where(eq(admins.id, card.receptionistId)).get() : undefined;

interface AccompanyingRow {
	name: string;
	dateOfBirth: string;
	citizenship: string;
}
let accompanying: AccompanyingRow[] = [];
try {
	if (card.accompanying) accompanying = JSON.parse(card.accompanying);
} catch {
	accompanying = [];
}
---

<AdminLayout title={formatCheckinCode(card.id)} adminName={currentAdmin.fullName} activeNav="checkin">
	<a href="/admin/checkin" class="back-link">{copy.back}</a>
	<h1>{formatCheckinCode(card.id)}</h1>

	{notice && <p class="notice">{notice}</p>}

	<div class="detail-grid">
		<section class="card">
			<h2>{copy.personalSection}</h2>
			<dl>
				<div><dt>{copy.firstName}</dt><dd>{card.firstName}</dd></div>
				<div><dt>{copy.lastName}</dt><dd>{card.lastName}</dd></div>
				<div><dt>{copy.dateOfBirth}</dt><dd>{card.dateOfBirth}</dd></div>
				<div><dt>{copy.citizenship}</dt><dd>{card.citizenship}</dd></div>
			</dl>
		</section>

		<section class="card">
			<h2>{copy.addressSection}</h2>
			<dl>
				<div><dt>{copy.country}</dt><dd>{card.country}</dd></div>
				<div><dt>{copy.city}</dt><dd>{card.city}</dd></div>
				<div><dt>{copy.street}</dt><dd>{card.street}</dd></div>
				<div><dt>{copy.zip}</dt><dd>{card.zipCode}</dd></div>
			</dl>
		</section>

		<section class="card">
			<h2>{copy.contactSection}</h2>
			<dl>
				<div><dt>{copy.phone}</dt><dd>{card.phone}</dd></div>
				<div><dt>{copy.email}</dt><dd>{card.email}</dd></div>
			</dl>
		</section>

		<section class="card">
			<h2>{copy.staySection}</h2>
			<dl>
				<div><dt>{copy.arrivalDate}</dt><dd>{card.arrivalDate}</dd></div>
				<div><dt>{copy.departureDate}</dt><dd>{card.departureDate}</dd></div>
			</dl>
		</section>

		<section class="card">
			<h2>{copy.accompanyingSection}</h2>
			{accompanying.length === 0 ? (
				<p class="field-note">{copy.noAccompanying}</p>
			) : (
				<dl>
					{accompanying.map((a) => (
						<div>
							<dt>{a.name}</dt>
							<dd>{a.dateOfBirth} · {a.citizenship}</dd>
						</div>
					))}
				</dl>
			)}
		</section>

		<section class="card">
			<h2>{copy.signatureSection}</h2>
			{card.guestSignatureDataUrl && <img src={card.guestSignatureDataUrl} alt={copy.signatureSection} class="signature-img" />}
			<p class="field-note">{copy.signedAt}: {card.guestSignedAt}</p>
		</section>

		<section class="card card--wide">
			<h2>{copy.receptionSection}</h2>
			<p class="field-note">{copy.receptionHint}</p>
			<form method="POST" class="reception-form">
				<div class="field-row">
					<label>
						{copy.roomBedNumber}
						<input type="text" name="roomBedNumber" value={card.roomBedNumber ?? ''} />
					</label>
					<label>
						{copy.documentNumber}
						<input type="text" name="documentNumber" value={card.documentNumber ?? ''} />
					</label>
				</div>
				<div class="field-row">
					<label>
						{copy.documentType}
						<select name="documentType">
							<option value="">—</option>
							<option value="passport" selected={card.documentType === 'passport'}>{copy.documentTypePassport}</option>
							<option value="id_card" selected={card.documentType === 'id_card'}>{copy.documentTypeId}</option>
							<option value="other" selected={card.documentType === 'other'}>{copy.documentTypeOther}</option>
						</select>
					</label>
					<label>
						{copy.documentTypeOther}
						<input type="text" name="documentTypeOther" value={card.documentTypeOther ?? ''} />
					</label>
				</div>
				<button type="submit" class="btn-secondary">{copy.verifyBtn}</button>
				{card.verifiedAt && receptionist && (
					<p class="field-note verified-note">
						{copy.verifiedBy}: {receptionist.fullName} · {card.verifiedAt}
					</p>
				)}
			</form>
		</section>
	</div>

	<style>
		.back-link {
			display: inline-block;
			margin-bottom: 0.75rem;
			font-size: 0.82rem;
			color: var(--text-dark-muted);
			text-decoration: none;
		}

		.back-link:hover {
			color: var(--accent);
		}

		h1 {
			margin: 0 0 1.25rem;
			font-size: 1.4rem;
			font-weight: 700;
		}

		.notice {
			background: rgba(63, 122, 79, 0.1);
			color: var(--success);
			border: 1px solid rgba(63, 122, 79, 0.3);
			border-radius: 0.6rem;
			padding: 0.6rem 0.9rem;
			margin: 0 0 1rem;
			font-size: 0.85rem;
		}

		.detail-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 1rem;
		}

		.card {
			background: #fff;
			border: 1px solid var(--border-light);
			border-radius: 0.85rem;
			padding: 1.25rem;
		}

		.card--wide {
			grid-column: 1 / -1;
		}

		.card h2 {
			margin: 0 0 0.9rem;
			font-size: 0.95rem;
			font-weight: 700;
		}

		dl {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			margin: 0;
		}

		dl div {
			display: flex;
			justify-content: space-between;
			gap: 1rem;
			font-size: 0.85rem;
		}

		dt {
			color: var(--text-dark-muted);
		}

		dd {
			margin: 0;
			text-align: right;
			font-weight: 600;
		}

		.field-note {
			margin: 0.5rem 0 0;
			font-size: 0.78rem;
			color: var(--text-dark-muted);
		}

		.signature-img {
			max-width: 100%;
			border: 1px solid var(--border-light);
			border-radius: 0.5rem;
			background: #fdfdfc;
		}

		.reception-form {
			display: flex;
			flex-direction: column;
			gap: 0.9rem;
			margin-top: 0.75rem;
		}

		.reception-form label {
			display: flex;
			flex-direction: column;
			gap: 0.3rem;
			font-size: 0.82rem;
			font-weight: 600;
		}

		.reception-form input,
		.reception-form select {
			font: inherit;
			font-size: 0.85rem;
			padding: 0.5rem 0.65rem;
			border-radius: 0.5rem;
			border: 1px solid var(--border-light);
		}

		.field-row {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 1rem;
		}

		.btn-secondary {
			align-self: flex-start;
			font: inherit;
			font-size: 0.8rem;
			font-weight: 700;
			padding: 0.55rem 1rem;
			border-radius: 0.5rem;
			border: none;
			background: var(--bg-dark);
			color: var(--cream);
			cursor: pointer;
		}

		.verified-note {
			color: var(--success);
			font-weight: 600;
		}

		@media (max-width: 760px) {
			.detail-grid {
				grid-template-columns: 1fr;
			}

			.field-row {
				grid-template-columns: 1fr;
			}
		}
	</style>
</AdminLayout>
