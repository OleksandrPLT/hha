---
// Ручне створення бронювання адміном (Фаза 4, за проханням користувача
// 2026-08-30) — для гостей, що звернулись по телефону/email або через
// Booking.com напряму (не через наш сайт). source фіксує канал.
// Доступність перевіряється (AJAX, той самий /api/booking/check-availability,
// що й на публічній формі) як попередження, не жорстка блокировка — адмін
// може свідомо створити запис навіть на "зайняті" дати (напр. виправляє
// помилку/дублікат), тому перевірка тут лише інформаційна.
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PhoneInput from '../../../components/PhoneInput.astro';
import { db } from '../../../db/client';
import { admins, bookings, rooms } from '../../../db/schema';
import { eq, asc } from 'drizzle-orm';
import { getAdminLocale, admin as adminCopy } from '../../../i18n/admin';
import { isValidEmail } from '../../../lib/auth';
import { isValidDateRange, nightsBetween } from '../../../lib/booking';

export const prerender = false;

const adminId = await Astro.session?.get('adminId');
if (!adminId) {
	return Astro.redirect('/admin/login');
}
const currentAdmin = db.select().from(admins).where(eq(admins.id, adminId)).get();
if (!currentAdmin) {
	return Astro.redirect('/admin/login');
}

const locale = getAdminLocale(Astro.cookies.get('admin_locale')?.value);
const copy = adminCopy[locale].bookingNew;
const activeRooms = db.select().from(rooms).where(eq(rooms.isActive, true)).orderBy(asc(rooms.sortOrder)).all();

function roomTitle(room: (typeof activeRooms)[number]): string {
	try {
		const parsed = JSON.parse(room.titles) as Record<string, string>;
		return parsed.en ?? room.slug;
	} catch {
		return room.slug;
	}
}

let error = '';
let values: Record<string, string> = { source: 'phone', guestsCount: '1' };

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	values = Object.fromEntries([...form.entries()].map(([k, v]) => [k, String(v)]));

	const roomId = Number(form.get('roomId'));
	const source = String(form.get('source') || 'phone');
	const fullName = String(form.get('fullName') || '').trim();
	const email = String(form.get('email') || '').trim().toLowerCase();
	const phoneCountry = String(form.get('phone_country') || '');
	const phoneNumber = String(form.get('phone') || '').trim();
	const checkIn = String(form.get('checkIn') || '');
	const checkOut = String(form.get('checkOut') || '');
	const guestsCount = Math.max(1, Math.min(10, Number(form.get('guestsCount')) || 1));
	const pricePerNightEuros = Number(form.get('pricePerNight'));
	const alreadyPaid = form.get('alreadyPaid') === 'on';

	const room = db.select().from(rooms).where(eq(rooms.id, roomId)).get();

	if (!room || !fullName || !isValidEmail(email) || !phoneNumber || !Number.isFinite(pricePerNightEuros) || pricePerNightEuros <= 0) {
		error = copy.errorRequired;
	} else if (!isValidDateRange(checkIn, checkOut)) {
		error = copy.errorDates;
	} else {
		const nights = nightsBetween(checkIn, checkOut);
		const pricePerNightCents = Math.round(pricePerNightEuros * 100);
		const totalCents = nights * pricePerNightCents;

		const inserted = db
			.insert(bookings)
			.values({
				roomId: room.id,
				guestId: null,
				fullName,
				email,
				phone: `${phoneCountry} ${phoneNumber}`,
				source,
				checkIn,
				checkOut,
				nights,
				guestsCount,
				pricePerNightCents,
				totalCents,
				status: 'confirmed',
				paymentStatus: alreadyPaid ? 'paid' : 'unpaid',
				paymentMethod: alreadyPaid ? 'cash' : null,
			})
			.run();

		return Astro.redirect(`/admin/bookings/${inserted.lastInsertRowid}`);
	}
}
---

<AdminLayout title={copy.title} adminName={currentAdmin.fullName} activeNav="bookings">
	<a href="/admin/bookings" class="back-link">← {adminCopy[locale].bookings.title}</a>
	<h1>{copy.title}</h1>
	<p class="page-subtitle">{copy.subtitle}</p>

	{error && <p class="notice notice--error">{error}</p>}

	<form method="POST" class="booking-new-form">
		<div class="field-row">
			<label>
				{copy.room}
				<select name="roomId" required>
					{activeRooms.map((r) => (
						<option value={r.id} selected={values.roomId === String(r.id)}>
							{roomTitle(r)}
						</option>
					))}
				</select>
			</label>
			<label>
				{copy.source}
				<select name="source">
					<option value="phone" selected={values.source === 'phone'}>{adminCopy[locale].bookings.sourcePhone}</option>
					<option value="email" selected={values.source === 'email'}>{adminCopy[locale].bookings.sourceEmail}</option>
					<option value="booking_com" selected={values.source === 'booking_com'}>{adminCopy[locale].bookings.sourceBookingCom}</option>
					<option value="website" selected={values.source === 'website'}>{adminCopy[locale].bookings.sourceWebsite}</option>
				</select>
			</label>
		</div>

		<div class="field-row">
			<label>
				{copy.fullName}
				<input type="text" name="fullName" required value={values.fullName ?? ''} />
			</label>
			<label>
				{copy.email}
				<input type="email" name="email" required value={values.email ?? ''} />
			</label>
		</div>
		<label>
			{copy.phone}
			<PhoneInput name="phone" required value={values.phone} countryValue={values.phone_country} />
		</label>

		<div class="field-row">
			<label>
				{copy.checkIn}
				<input type="date" name="checkIn" id="checkIn" required value={values.checkIn ?? ''} />
			</label>
			<label>
				{copy.checkOut}
				<input type="date" name="checkOut" id="checkOut" required value={values.checkOut ?? ''} />
			</label>
		</div>
		<p id="availability-msg" class="availability-msg" hidden></p>

		<div class="field-row">
			<label>
				{copy.guestsCount}
				<input type="number" name="guestsCount" min="1" max="10" value={values.guestsCount ?? '1'} />
			</label>
			<label>
				{copy.pricePerNight}
				<input type="number" step="0.01" name="pricePerNight" id="pricePerNight" required value={values.pricePerNight ?? ''} />
			</label>
		</div>
		<p class="field-note">{copy.pricePerNightHint}</p>

		<label class="checkbox-row">
			<input type="checkbox" name="alreadyPaid" checked={values.alreadyPaid === 'on'} />
			<span>{copy.alreadyPaid}</span>
		</label>

		<button type="submit" class="btn-primary">{copy.createBtn}</button>
	</form>

	<script define:vars={{ roomsData: activeRooms.map((r) => ({ id: r.id, price: r.pricePerNightCents / 100 })), warningText: copy.availabilityWarning }}>
		const roomSelect = document.querySelector('select[name="roomId"]');
		const priceInput = document.getElementById('pricePerNight');
		const checkInEl = document.getElementById('checkIn');
		const checkOutEl = document.getElementById('checkOut');
		const msgEl = document.getElementById('availability-msg');

		function fillPrice() {
			if (priceInput.value) return;
			const room = roomsData.find((r) => String(r.id) === roomSelect.value);
			if (room) priceInput.value = room.price.toFixed(2);
		}
		roomSelect?.addEventListener('change', fillPrice);
		fillPrice();

		async function checkAvailability() {
			const roomId = roomSelect.value;
			const ci = checkInEl.value;
			const co = checkOutEl.value;
			if (!roomId || !ci || !co) return;
			try {
				const res = await fetch(`/api/booking/check-availability?roomId=${roomId}&checkIn=${ci}&checkOut=${co}`);
				const data = await res.json();
				if (data.available === false) {
					msgEl.hidden = false;
					msgEl.textContent = warningText;
				} else {
					msgEl.hidden = true;
				}
			} catch {
				msgEl.hidden = true;
			}
		}
		checkInEl?.addEventListener('change', checkAvailability);
		checkOutEl?.addEventListener('change', checkAvailability);
		roomSelect?.addEventListener('change', checkAvailability);
	</script>

	<style>
		.back-link {
			display: inline-block;
			margin-bottom: 0.75rem;
			font-size: 0.82rem;
			color: var(--text-dark-muted);
			text-decoration: none;
		}

		.back-link:hover {
			color: var(--accent);
		}

		h1 {
			margin: 0 0 0.3rem;
			font-size: 1.4rem;
			font-weight: 700;
		}

		.page-subtitle {
			margin: 0 0 1.25rem;
			font-size: 0.85rem;
			color: var(--text-dark-muted);
			max-width: 40rem;
		}

		.notice {
			border-radius: 0.6rem;
			padding: 0.65rem 0.9rem;
			margin: 0 0 1rem;
			font-size: 0.85rem;
		}

		.notice--error {
			background: rgba(179, 67, 47, 0.1);
			color: var(--danger);
			border: 1px solid rgba(179, 67, 47, 0.3);
		}

		.booking-new-form {
			display: flex;
			flex-direction: column;
			gap: 1rem;
			background: #fff;
			border: 1px solid var(--border-light);
			border-radius: 0.85rem;
			padding: 1.5rem;
			max-width: 36rem;
		}

		.booking-new-form label {
			display: flex;
			flex-direction: column;
			gap: 0.35rem;
			font-size: 0.85rem;
			font-weight: 600;
			color: var(--text-dark);
		}

		.booking-new-form input,
		.booking-new-form select {
			font: inherit;
			font-weight: 400;
			padding: 0.55rem 0.7rem;
			border-radius: 0.5rem;
			border: 1px solid var(--border-light);
			background: #fff;
			color: var(--text-dark);
		}

		.field-row {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 1rem;
		}

		.field-note {
			margin: -0.5rem 0 0;
			font-size: 0.75rem;
			color: var(--text-dark-muted);
		}

		.availability-msg {
			margin: -0.5rem 0 0;
			font-size: 0.82rem;
			font-weight: 600;
			color: #a16a1a;
		}

		.checkbox-row {
			flex-direction: row !important;
			align-items: center;
			gap: 0.5rem;
		}

		.btn-primary {
			align-self: flex-start;
			font: inherit;
			font-size: 0.85rem;
			font-weight: 700;
			padding: 0.6rem 1.2rem;
			border-radius: 0.5rem;
			border: none;
			background: var(--bg-dark);
			color: var(--cream);
			cursor: pointer;
		}

		@media (max-width: 560px) {
			.field-row {
				grid-template-columns: 1fr;
			}
		}
	</style>
</AdminLayout>
