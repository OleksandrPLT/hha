---
// Вхід в адмін-кабінет — окрема сесійна мітка adminId (не guestId), щоб не
// плутати з кабінетом гостя, навіть якщо той самий браузер колись
// заходив і туди, і туди.
import { db } from '../../db/client';
import { admins as adminsTable } from '../../db/schema';
import { verifyPassword } from '../../lib/auth';
import { eq } from 'drizzle-orm';
import { getAdminLocale, admin as adminCopy } from '../../i18n/admin';

export const prerender = false;

const locale = getAdminLocale(Astro.cookies.get('admin_locale')?.value);
const copy = adminCopy[locale].login;

let error = '';
let emailValue = '';

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const email = String(form.get('email') || '')
		.trim()
		.toLowerCase();
	const password = String(form.get('password') || '');
	emailValue = email;

	const adminRow = db.select().from(adminsTable).where(eq(adminsTable.email, email)).get();
	if (!adminRow || !(await verifyPassword(password, adminRow.passwordHash))) {
		error = copy.errorInvalid;
	} else {
		await Astro.session?.set('adminId', adminRow.id);
		return Astro.redirect('/admin');
	}
}
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{copy.title} — {copy.subtitle}</title>
		<style>
			@import '@fontsource-variable/inter';

			* {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				padding: 0;
			}

			body {
				font-family: 'Inter Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
				background: #0b0d10;
				color: #14161a;
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 1.5rem;
			}

			.card {
				width: 100%;
				max-width: 22rem;
				background: #fff;
				border-radius: 1rem;
				padding: 2rem 1.75rem;
				box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
			}

			h1 {
				margin: 0 0 0.3rem;
				font-size: 1.3rem;
				font-weight: 700;
			}

			.subtitle {
				margin: 0 0 1.5rem;
				font-size: 0.85rem;
				color: #5b6068;
			}

			.form-error {
				background: rgba(234, 67, 53, 0.1);
				color: #c0392b;
				border: 1px solid rgba(234, 67, 53, 0.3);
				border-radius: 0.6rem;
				padding: 0.7rem 0.9rem;
				margin-bottom: 1.1rem;
				font-size: 0.85rem;
			}

			form {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			label {
				display: flex;
				flex-direction: column;
				gap: 0.3rem;
				font-size: 0.82rem;
				font-weight: 600;
			}

			input {
				font: inherit;
				font-weight: 400;
				padding: 0.6rem 0.75rem;
				border-radius: 0.5rem;
				border: 1px solid #e2e5ea;
			}

			button {
				height: 2.7rem;
				border: none;
				border-radius: 0.6rem;
				background: #0b0d10;
				color: #f5f5f3;
				font-size: 0.88rem;
				font-weight: 700;
				cursor: pointer;
			}

			button:hover {
				background: #000;
			}

			.lang-switch {
				display: flex;
				justify-content: flex-end;
				gap: 0.3rem;
				margin-bottom: 0.75rem;
			}

			.lang-switch a {
				font-size: 0.7rem;
				font-weight: 700;
				color: #8a8f98;
				text-decoration: none;
				padding: 0.15rem 0.4rem;
				border-radius: 0.3rem;
			}

			.lang-switch a.is-active {
				background: #e2e5ea;
				color: #14161a;
			}
		</style>
	</head>
	<body>
		<div class="card">
			<div class="lang-switch">
				<a href={`/admin/set-locale?locale=uk&return=${encodeURIComponent('/admin/login')}`} class={locale === 'uk' ? 'is-active' : ''}>UK</a>
				<a href={`/admin/set-locale?locale=ru&return=${encodeURIComponent('/admin/login')}`} class={locale === 'ru' ? 'is-active' : ''}>RU</a>
			</div>
			<h1>{copy.title}</h1>
			<p class="subtitle">{copy.subtitle}</p>
			{error && <p class="form-error">{error}</p>}
			<form method="POST">
				<label>
					{copy.email}
					<input type="email" name="email" required value={emailValue} />
				</label>
				<label>
					{copy.password}
					<input type="password" name="password" required />
				</label>
				<button type="submit">{copy.submit}</button>
			</form>
		</div>
	</body>
</html>
