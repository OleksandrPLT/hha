---
// Редагування профілю — та сама "максимальна анкета", що й реєстрація,
// мінус пароль (для зміни пароля є окремий forgot-password flow) і мінус
// dataProcessingConsent (згода дається один раз при реєстрації, тут її не
// перепідтверджують — GDPR не вимагає re-consent на кожне редагування,
// тільки чіткий шлях відкликання, для чого є delete.astro).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import PhoneInput from '../../../components/PhoneInput.astro';
import { isLocale, defaultLocale, type Locale } from '../../../i18n/locales';
import { account } from '../../../i18n/account';
import { countries } from '../../../data/countries';
import { db } from '../../../db/client';
import { guests } from '../../../db/schema';
import { isValidEmail } from '../../../lib/auth';
import { isGoogleOAuthConfigured } from '../../../lib/oauth';
import { isTelegramConfigured, telegramBotUsername } from '../../../lib/telegram';
import { linkOrganization } from '../../../lib/organization';
import { eq, and, ne } from 'drizzle-orm';

const rawLocale = Astro.params.locale;
if (!rawLocale || !isLocale(rawLocale)) {
	return Astro.redirect(`/${defaultLocale}/account/edit`);
}
const locale: Locale = rawLocale;
const copy = account[locale].editProfile;
const regCopy = account[locale].register;
const googleReady = isGoogleOAuthConfigured();
const telegramReady = isTelegramConfigured();

const linkedNotice = ['google', 'telegram'].includes(Astro.url.searchParams.get('linked') ?? '');
const unlinkedNotice = ['google', 'telegram'].includes(Astro.url.searchParams.get('unlinked') ?? '');
const oauthErrorParam = Astro.url.searchParams.get('oauthError');

const guestId = await Astro.session?.get('guestId');
if (!guestId) {
	return Astro.redirect(`/${locale}/account/login`);
}

const guest = db.select().from(guests).where(eq(guests.id, guestId)).get();
if (!guest) {
	return Astro.redirect(`/${locale}/account/login`);
}

const initials = guest.fullName
	.split(/\s+/)
	.filter(Boolean)
	.slice(0, 2)
	.map((p) => p[0]!.toUpperCase())
	.join('');

let error = '';
const updatedNotice = Astro.url.searchParams.get('updated') === '1';

// Значення полів форми — з guest за замовчуванням, перебиваються values
// POST-даними, якщо була спроба сабміту з помилкою (щоб не втрачати те,
// що гість щойно ввів).
let values: Record<string, string> = {
	accountType: guest.isCompany ? 'company' : 'individual',
	fullName: guest.fullName,
	email: guest.email,
	phone_country: guest.phone.split(' ')[0] ?? '',
	phone: guest.phone.split(' ').slice(1).join(' '),
	nationality: guest.nationality ?? '',
	dateOfBirth: guest.dateOfBirth ?? '',
	address: guest.addressLine ?? '',
	city: guest.city ?? '',
	postalCode: guest.postalCode ?? '',
	countryOfResidence: guest.countryOfResidence ?? '',
	companyName: guest.companyName ?? '',
	companyRegCode: guest.companyRegCode ?? '',
	companyVat: guest.companyVat ?? '',
	companyAddress: guest.companyAddress ?? '',
	marketingConsent: guest.marketingConsent ? 'on' : '',
};

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const posted = Object.fromEntries([...form.entries()].map(([k, v]) => [k, String(v)]));
	values = { ...values, ...posted, marketingConsent: form.get('marketingConsent') === 'on' ? 'on' : '' };

	const isCompany = form.get('accountType') === 'company';
	const fullName = String(form.get('fullName') || '').trim();
	const email = String(form.get('email') || '')
		.trim()
		.toLowerCase();
	const phoneCountry = String(form.get('phone_country') || '');
	const phoneNumber = String(form.get('phone') || '').trim();

	if (!fullName || !isValidEmail(email) || !phoneNumber) {
		error = copy.errorGeneric;
	} else {
		const existing = db
			.select()
			.from(guests)
			.where(and(eq(guests.email, email), ne(guests.id, guestId)))
			.get();
		if (existing) {
			error = copy.errorEmailTaken;
		} else {
			// avatarUrl — прихований інпут, який заповнює клієнтський JS
			// (canvas-ресайз завантаженого файлу в data URL). Порожній рядок =
			// гість нічого не міняв — лишаємо старе фото, не затираємо.
			// removeAvatar='on' — явне прибирання фото окремою кнопкою.
			const submittedAvatar = String(form.get('avatarUrl') || '');
			const removeAvatar = form.get('removeAvatar') === 'on';
			const avatarUpdate = removeAvatar
				? { avatarUrl: null, avatarSource: null }
				: submittedAvatar
					? { avatarUrl: submittedAvatar, avatarSource: 'upload' }
					: {};

			const companyName = String(form.get('companyName') || '');
			const companyRegCode = String(form.get('companyRegCode') || '');
			const companyVat = String(form.get('companyVat') || '');
			const companyAddress = String(form.get('companyAddress') || '');
			// Прив'язка до спільної організації (2026-08-30) — find-or-create по
			// regCode, щоб кілька гостей з тим самим regCode ділили один запис.
			const organizationId = isCompany && (companyName || companyRegCode) ? linkOrganization({ name: companyName, regCode: companyRegCode, vat: companyVat, address: companyAddress }) : null;

			db.update(guests)
				.set({
					fullName,
					email,
					phone: `${phoneCountry} ${phoneNumber}`,
					isCompany,
					companyName: isCompany ? companyName || null : null,
					companyRegCode: isCompany ? companyRegCode || null : null,
					companyVat: isCompany ? companyVat || null : null,
					companyAddress: isCompany ? companyAddress || null : null,
					organizationId,
					nationality: String(form.get('nationality') || '') || null,
					dateOfBirth: String(form.get('dateOfBirth') || '') || null,
					addressLine: String(form.get('address') || '') || null,
					city: String(form.get('city') || '') || null,
					postalCode: String(form.get('postalCode') || '') || null,
					countryOfResidence: String(form.get('countryOfResidence') || '') || null,
					marketingConsent: form.get('marketingConsent') === 'on',
					...avatarUpdate,
				})
				.where(eq(guests.id, guestId))
				.run();

			// Post/Redirect/Get — уникає застарілого guest (закритого над
			// insert/update) у тому ж рендері й повторного сабміту форми на
			// F5 після успіху.
			return Astro.redirect(`/${locale}/account/edit?updated=1`);
		}
	}
}
---

<BaseLayout locale={locale} title={`${copy.title} — Hostel & Hotel Apartments`} description={copy.subtitle} path="/account/edit">
	<SiteHeader locale={locale} />

	<main class="modal-page">
		<a class="modal-page__scrim" href={`/${locale}/account`} aria-label="Close"></a>
		<div class="modal-page__card">
			<a class="modal-page__close" href={`/${locale}/account`} aria-label="Close">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
			</a>

			<h1>{copy.title}</h1>
			<p class="subtitle">{copy.subtitle}</p>

			{updatedNotice && <p class="form-success">{copy.successMessage}</p>}
			{linkedNotice && <p class="form-success">{copy.linkedSuccess}</p>}
			{unlinkedNotice && <p class="form-success">{copy.unlinkedSuccess}</p>}
			{error && <p class="form-error">{error}</p>}
			{oauthErrorParam === 'taken' && <p class="form-error">{copy.oauthErrorTaken}</p>}
			{oauthErrorParam === '1' && <p class="form-error">{copy.oauthErrorGeneric}</p>}

			<div class="photo-section">
				<div class="photo-preview" id="photo-preview">
					{guest.avatarUrl ? <img src={guest.avatarUrl} alt="" id="photo-preview-img" /> : <span id="photo-preview-initials">{initials}</span>}
				</div>
				<div class="photo-actions">
					<p class="photo-title">{copy.photoTitle}</p>
					<div class="photo-buttons">
						<label class="btn btn--ghost-small">
							{copy.photoUpload}
							<input type="file" id="photo-input" accept="image/*" hidden />
						</label>
						{guest.avatarUrl && (
							<button type="submit" form="edit-form" name="removeAvatar" value="on" class="btn btn--ghost-small btn--danger-text">
								{copy.photoRemove}
							</button>
						)}
					</div>
				</div>
			</div>

			<div class="connected-section">
				<p class="connected-title">{copy.connectedTitle}</p>
				<div class="connected-row">
					<span class="connected-provider">
						<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
							<path fill="#4285F4" d="M23.52 12.27c0-.82-.07-1.6-.2-2.36H12v4.47h6.47c-.28 1.5-1.13 2.78-2.4 3.63v3.02h3.88c2.27-2.09 3.57-5.17 3.57-8.76z" />
							<path fill="#34A853" d="M12 24c3.24 0 5.96-1.07 7.95-2.9l-3.88-3.02c-1.08.72-2.45 1.15-4.07 1.15-3.13 0-5.78-2.11-6.73-4.96H1.26v3.11C3.24 21.3 7.29 24 12 24z" />
							<path fill="#FBBC05" d="M5.27 14.27c-.25-.72-.38-1.49-.38-2.27s.14-1.55.38-2.27V6.62H1.26A11.97 11.97 0 0 0 0 12c0 1.93.46 3.76 1.26 5.38l4.01-3.11z" />
							<path fill="#EA4335" d="M12 4.77c1.77 0 3.35.61 4.6 1.8l3.44-3.44C17.95 1.19 15.24 0 12 0 7.29 0 3.24 2.7 1.26 6.62l4.01 3.11C6.22 6.88 8.87 4.77 12 4.77z" />
						</svg>
						Google
						{guest.googleId && <span class="connected-badge">{copy.googleConnected}</span>}
					</span>
					{guest.googleId ? (
						<form method="POST" action="/api/oauth/google/disconnect">
							<input type="hidden" name="locale" value={locale} />
							<button type="submit" class="btn btn--ghost-small">{copy.disconnectGoogle}</button>
						</form>
					) : googleReady ? (
						<a class="btn btn--ghost-small" href={`/api/oauth/google/start?locale=${locale}`}>{copy.connectGoogle}</a>
					) : (
						<button type="button" class="btn btn--ghost-small" disabled title="Coming soon">{copy.connectGoogle}</button>
					)}
				</div>
				<div class="connected-row">
					<span class="connected-provider">
						<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
							<circle cx="12" cy="12" r="12" fill="#26A5E4" />
							<path fill="#fff" d="M5.4 12.1l12-4.6c.6-.2 1.1.3.9 1l-2 9.3c-.1.5-.7.7-1.1.4l-3.1-2.3-1.5 1.4c-.2.2-.4.2-.6.1l.3-2.7 5.5-5-6.9 4.3-2.8-.9c-.6-.2-.6-.6.3-1z" />
						</svg>
						Telegram
						{guest.telegramId && <span class="connected-badge">{copy.telegramConnected}</span>}
					</span>
					{guest.telegramId ? (
						<form method="POST" action="/api/oauth/telegram/disconnect">
							<input type="hidden" name="locale" value={locale} />
							<button type="submit" class="btn btn--ghost-small">{copy.disconnectTelegram}</button>
						</form>
					) : telegramReady ? (
						<div class="telegram-widget-slot" id="telegram-widget-slot" data-bot-username={telegramBotUsername()} data-auth-url={`https://hha.ee/api/oauth/telegram/callback?locale=${locale}`} />
					) : (
						<button type="button" class="btn btn--ghost-small" disabled title="Coming soon">{copy.connectTelegram}</button>
					)}
				</div>
			</div>

			<form method="POST" class="account-form" id="edit-form">
				<input type="hidden" name="avatarUrl" id="avatar-url-field" value="" />
				<div class="account-type-toggle">
					<label>
						<input type="radio" name="accountType" value="individual" checked={values.accountType !== 'company'} />
						{regCopy.accountTypeIndividual}
					</label>
					<label>
						<input type="radio" name="accountType" value="company" checked={values.accountType === 'company'} />
						{regCopy.accountTypeCompany}
					</label>
				</div>

				<div class="company-fields" id="company-fields" hidden>
					<label>
						{regCopy.companyName}
						<input type="text" name="companyName" value={values.companyName ?? ''} />
					</label>
					<label>
						{regCopy.companyRegCode}
						<input type="text" name="companyRegCode" value={values.companyRegCode ?? ''} />
					</label>
					<label>
						{regCopy.companyVat}
						<input type="text" name="companyVat" value={values.companyVat ?? ''} />
					</label>
					<label>
						{regCopy.companyAddress}
						<input type="text" name="companyAddress" value={values.companyAddress ?? ''} />
					</label>
					<p class="field-note">{regCopy.companyLookupNote}</p>
				</div>

				<label>
					{regCopy.fullName}
					<input type="text" name="fullName" required value={values.fullName ?? ''} />
				</label>

				<label>
					{regCopy.email}
					<input type="email" name="email" required value={values.email ?? ''} />
				</label>

				<label>
					{regCopy.phone}
					<PhoneInput name="phone" required value={values.phone} countryValue={values.phone_country} />
				</label>

				<div class="field-row">
					<label>
						{regCopy.nationality}
						<select name="nationality">
							<option value="">—</option>
							{countries.map((c) => <option value={c.iso2} selected={values.nationality === c.iso2}>{c.name}</option>)}
						</select>
					</label>
					<label>
						{regCopy.dateOfBirth}
						<input type="date" name="dateOfBirth" value={values.dateOfBirth ?? ''} />
					</label>
				</div>

				<label>
					{regCopy.address}
					<input type="text" name="address" value={values.address ?? ''} />
				</label>

				<div class="field-row">
					<label>
						{regCopy.city}
						<input type="text" name="city" value={values.city ?? ''} />
					</label>
					<label>
						{regCopy.postalCode}
						<input type="text" name="postalCode" value={values.postalCode ?? ''} />
					</label>
				</div>

				<label>
					{regCopy.countryOfResidence}
					<select name="countryOfResidence">
						<option value="">—</option>
						{countries.map((c) => <option value={c.iso2} selected={values.countryOfResidence === c.iso2}>{c.name}</option>)}
					</select>
				</label>

				<label class="checkbox-row">
					<input type="checkbox" name="marketingConsent" checked={values.marketingConsent === 'on'} />
					{regCopy.marketingConsent}
				</label>

				<button type="submit" class="btn btn--primary-dark">{copy.submit}</button>

				<p class="form-footnote">
					<a href={`/${locale}/account`}>{copy.backToAccount}</a>
				</p>
			</form>
		</div>
	</main>

	<SiteFooter locale={locale} />

	<script is:inline>
		(function () {
			var radios = document.querySelectorAll('input[name="accountType"]');
			var companyFields = document.getElementById('company-fields');
			function sync() {
				var isCompany = document.querySelector('input[name="accountType"]:checked')?.value === 'company';
				if (companyFields) companyFields.hidden = !isCompany;
			}
			radios.forEach(function (r) {
				r.addEventListener('change', sync);
			});
			sync();
		})();

		// Фото профілю — ресайз на клієнті через canvas (макс 200x200,
		// cover-crop по центру, JPEG q=0.82), щоб не ганяти й не зберігати
		// мегабайтні оригінали (немає окремого файлового сховища на цьому
		// хостингу — фото йде в БД як data URL, див. коментар в db/schema.ts).
		(function () {
			var input = document.getElementById('photo-input');
			var hiddenField = document.getElementById('avatar-url-field');
			var preview = document.getElementById('photo-preview');
			if (!input || !hiddenField || !preview) return;

			input.addEventListener('change', function () {
				var file = input.files && input.files[0];
				if (!file) return;

				var img = new Image();
				var reader = new FileReader();
				reader.onload = function (e) {
					img.onload = function () {
						var size = 200;
						var canvas = document.createElement('canvas');
						canvas.width = size;
						canvas.height = size;
						var ctx = canvas.getContext('2d');
						var scale = Math.max(size / img.width, size / img.height);
						var w = img.width * scale;
						var h = img.height * scale;
						ctx.drawImage(img, (size - w) / 2, (size - h) / 2, w, h);
						var dataUrl = canvas.toDataURL('image/jpeg', 0.82);
						hiddenField.value = dataUrl;

						preview.innerHTML = '';
						var previewImg = document.createElement('img');
						previewImg.src = dataUrl;
						previewImg.alt = '';
						preview.appendChild(previewImg);
					};
					img.src = String(e.target && e.target.result);
				};
				reader.readAsDataURL(file);
			});
		})();

		(function () {
			var slot = document.getElementById('telegram-widget-slot');
			if (!slot) return;
			var s = document.createElement('script');
			s.async = true;
			s.src = 'https://telegram.org/js/telegram-widget.js?22';
			s.setAttribute('data-telegram-login', slot.dataset.botUsername);
			s.setAttribute('data-size', 'large');
			s.setAttribute('data-radius', '8');
			s.setAttribute('data-auth-url', slot.dataset.authUrl);
			s.setAttribute('data-request-access', 'write');
			slot.appendChild(s);
		})();
	</script>

	<style>
		.modal-page {
			position: relative;
			display: flex;
			align-items: flex-start;
			justify-content: center;
			padding: 3rem 1.25rem 4rem;
			background: var(--bg-dark);
			overflow: hidden;
		}

		.modal-page__scrim {
			position: absolute;
			inset: 0;
			background: radial-gradient(circle at 50% 15%, rgba(0, 114, 206, 0.22), transparent 55%);
			filter: blur(40px);
		}

		.modal-page__card {
			position: relative;
			width: 100%;
			max-width: 28rem;
			background: #fff;
			color: var(--text-dark);
			border-radius: 1rem;
			padding: 1.75rem 1.5rem;
			border: 1px solid var(--border-light);
			box-shadow: 0 24px 60px rgba(20, 22, 26, 0.16);
			animation: modal-pop 0.16s ease;
		}

		@keyframes modal-pop {
			from {
				opacity: 0;
				transform: translateY(8px) scale(0.98);
			}
			to {
				opacity: 1;
				transform: translateY(0) scale(1);
			}
		}

		.modal-page__close {
			position: absolute;
			top: 0.85rem;
			right: 0.85rem;
			width: 2.1rem;
			height: 2.1rem;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			color: var(--text-dark-muted);
			text-decoration: none;
		}

		.modal-page__close:hover {
			background: rgba(0, 0, 0, 0.06);
			color: var(--text-dark);
		}

		h1 {
			margin: 0 0 0.4rem;
			font-family: var(--font-display);
			font-size: clamp(1.3rem, 4vw, 1.6rem);
			font-weight: 600;
			padding-right: 1.75rem;
		}

		.subtitle {
			margin: 0 0 1.5rem;
			font-size: 0.88rem;
			color: var(--text-dark-muted);
		}

		.form-error {
			background: rgba(234, 67, 53, 0.1);
			color: #c0392b;
			border: 1px solid rgba(234, 67, 53, 0.3);
			border-radius: 0.6rem;
			padding: 0.75rem 1rem;
			margin-bottom: 1.25rem;
			font-size: 0.9rem;
		}

		.form-success {
			background: rgba(63, 122, 79, 0.1);
			color: #3f7a4f;
			border: 1px solid rgba(63, 122, 79, 0.3);
			border-radius: 0.6rem;
			padding: 0.75rem 1rem;
			margin-bottom: 1.25rem;
			font-size: 0.9rem;
		}

		.photo-section {
			display: flex;
			align-items: center;
			gap: 1rem;
			padding: 1rem;
			border: 1px solid var(--border-light);
			border-radius: 0.7rem;
			margin-bottom: 1.1rem;
		}

		.photo-preview {
			width: 3.5rem;
			height: 3.5rem;
			border-radius: 50%;
			overflow: hidden;
			flex-shrink: 0;
			background: var(--accent);
			color: var(--accent-ink);
			display: flex;
			align-items: center;
			justify-content: center;
			font-family: var(--font-display);
			font-weight: 600;
			font-size: 1.1rem;
		}

		.photo-preview img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.photo-actions {
			flex: 1;
			min-width: 0;
		}

		.photo-title {
			margin: 0 0 0.4rem;
			font-size: 0.82rem;
			font-weight: 600;
			color: var(--text-dark);
		}

		.photo-buttons {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
		}

		.btn--ghost-small {
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
			height: 2.1rem;
			padding: 0 0.8rem;
			border-radius: 0.5rem;
			border: 1px solid var(--border-light);
			background: #fff;
			color: var(--text-dark);
			font-size: 0.78rem;
			font-weight: 600;
			text-decoration: none;
			cursor: pointer;
		}

		.btn--ghost-small:hover {
			border-color: var(--accent);
			color: var(--accent);
		}

		.btn--ghost-small[disabled] {
			cursor: not-allowed;
			opacity: 0.55;
		}

		.btn--danger-text {
			color: #b3432f;
		}

