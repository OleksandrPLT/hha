---
// Кабінет гостя за URL з номером гостя (за проханням користувача
// 2026-08-30: "в адресній строці ід чому не вивів" — має бути видно ID
// прямо в адресному рядку, не тільки всередині QR). Сам [memberId] в URL —
// ЛИШЕ для показу/канонічного посилання, НЕ для авторизації/пошуку: хто
// саме гість — завжди визначається сесією (guestId), як і раніше. Якщо в
// URL стоїть чужий/невірний memberId — просто редиректимо на власний
// (не 403/404) — це виключає навіть теоретичний IDOR (підставити чужий ID
// і побачити чиїсь дані ніяк не можна, дані завжди беруться з сесії).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { isLocale, defaultLocale, htmlLang, type Locale } from '../../../i18n/locales';
import { account } from '../../../i18n/account';
import { db } from '../../../db/client';
import { guests, bookings, rooms } from '../../../db/schema';
import { eq, desc } from 'drizzle-orm';
import { pointsToEuros } from '../../../data/loyalty';
import { countries, isoToFlag } from '../../../data/countries';
import { formatMemberId, memberVerifyUrl, generateMemberQrSvg } from '../../../lib/memberCard';
import { booking as bookingCopy } from '../../../i18n/booking';
import { currency } from '../../../data/pricing';

const rawLocale = Astro.params.locale;
if (!rawLocale || !isLocale(rawLocale)) {
	return Astro.redirect(`/${defaultLocale}/account`);
}
const locale: Locale = rawLocale;
const copy = account[locale];

const guestId = await Astro.session?.get('guestId');
if (!guestId) {
	return Astro.redirect(`/${locale}/account/login`);
}

const guest = db.select().from(guests).where(eq(guests.id, guestId)).get();
if (!guest) {
	return Astro.redirect(`/${locale}/account/login`);
}

const memberId = formatMemberId(guest.id);
if (Astro.params.memberId !== memberId) {
	return Astro.redirect(`/${locale}/account/${memberId}`);
}

function countryLabel(iso: string | null): string | null {
	if (!iso) return null;
	const c = countries.find((c) => c.iso2 === iso);
	return c ? `${isoToFlag(c.iso2)} ${c.name}` : iso;
}

function formatDate(raw: string | null): string | null {
	if (!raw) return null;
	// createdAt приходить як "YYYY-MM-DD HH:MM:SS" (SQLite CURRENT_TIMESTAMP),
	// dateOfBirth — як "YYYY-MM-DD" (input type=date). Обидва парсяться однаково.
	const d = new Date(raw.includes(' ') ? raw.replace(' ', 'T') + 'Z' : raw);
	if (Number.isNaN(d.getTime())) return raw;
	return new Intl.DateTimeFormat(htmlLang[locale], { dateStyle: 'medium' }).format(d);
}

const memberSinceLabel = formatDate(guest.createdAt);
const initials = guest.fullName
	.split(/\s+/)
	.filter(Boolean)
	.slice(0, 2)
	.map((p) => p[0]!.toUpperCase())
	.join('');

const verifyUrl = memberVerifyUrl(Astro.site ?? Astro.url, locale, memberId);
const qrSvg = await generateMemberQrSvg(verifyUrl);

// "Історія проживань" (Фаза 4) — власні бронювання гостя, найновіші перші.
// Гостьові бронювання (без акаунта) сюди не потрапляють — прив'язка йде
// лише через guestId, зроблену в момент оформлення (якщо гість тоді був
// залогінений).
const myBookings = db.select().from(bookings).where(eq(bookings.guestId, guestId)).orderBy(desc(bookings.createdAt)).all();
const roomsById = new Map(db.select().from(rooms).all().map((r) => [r.id, r]));
const bkCopy = bookingCopy[locale];

function roomTitleFor(roomId: number): string {
	const room = roomsById.get(roomId);
	if (!room) return '—';
	try {
		const parsed = JSON.parse(room.titles) as Record<string, string>;
		return parsed[locale] ?? parsed.en ?? room.slug;
	} catch {
		return room.slug;
	}
}

const bookingStatusLabels: Record<string, string> = {
	pending: bkCopy.confirmation.statusPending,
	confirmed: bkCopy.confirmation.statusConfirmed,
	cancelled: bkCopy.confirmation.statusCancelled,
	completed: bkCopy.confirmation.statusCompleted,
};
const bookingPaymentLabels: Record<string, string> = {
	paid: bkCopy.confirmation.paymentPaid,
	unpaid: bkCopy.confirmation.paymentUnpaid,
	refunded: bkCopy.confirmation.paymentUnpaid,
};
---

<BaseLayout locale={locale} title={`${copy.dashboard.title} — Hostel & Hotel Apartments`} description={copy.dashboard.title} path={`/account/${memberId}`}>
	<SiteHeader locale={locale} />

	<main class="dash">
		<div class="dash-shell">
			<aside class="dash-sidebar">
				<div class="loyalty-card">
					<p class="loyalty-card__label">{copy.dashboard.loyaltyPoints}</p>
					<p class="loyalty-card__points">
						{guest.loyaltyPoints}
						<span>≈ €{pointsToEuros(guest.loyaltyPoints).toFixed(2)}</span>
					</p>
					<p class="loyalty-card__note">{copy.dashboard.loyaltyNote}</p>
				</div>

				<div class="member-card">
					<div class="member-card__qr" set:html={qrSvg} />
					<p class="member-card__id">{memberId}</p>
					<p class="member-card__note">{copy.dashboard.scanNote}</p>
				</div>

				<nav aria-label="Account">
					<ul class="dash-nav">
						<li>
							<a href={`/${locale}/account/${memberId}`} class="dash-nav__link is-active">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
									><rect x="3" y="3" width="7" height="9" rx="1.5"></rect><rect x="14" y="3" width="7" height="5" rx="1.5"></rect><rect
										x="14"
										y="12"
										width="7"
										height="9"
										rx="1.5"></rect><rect x="3" y="16" width="7" height="5" rx="1.5"></rect></svg
								>
								{copy.dashboard.navOverview}
							</a>
						</li>
						<li>
							<a href="#account-details" class="dash-nav__link">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
									><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"></path></svg
								>
								{copy.dashboard.navAccountDetails}
							</a>
						</li>
						<li>
							<a href="#stay-history" class="dash-nav__link">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
									><rect x="3" y="7" width="18" height="13" rx="2"></rect><path d="M16 3v4M8 3v4M3 11h18"></path></svg
								>
								{copy.dashboard.navStayHistory}
							</a>
						</li>
						<li>
							<a href={`/${locale}/account/edit`} class="dash-nav__link">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
									><path
										d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 013 3L7 19l-4 1 1-4z"></path></svg
								>
								{copy.dashboard.editProfile}
							</a>
						</li>
					</ul>

					<div class="dash-nav-divider"></div>

					<a href={`/${locale}/account/delete`} class="dash-nav__link dash-nav__danger">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
							><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2"></path><path
								d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"></path></svg
						>
						{copy.dashboard.deleteAccount}
					</a>

					<div class="dash-nav-divider"></div>

					<form method="POST" action={`/${locale}/account/logout`}>
						<button type="submit" class="dash-nav__link dash-nav__logout">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
								><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path><path d="M16 17l5-5-5-5"></path><path d="M21 12H9"></path></svg
							>
							{copy.dashboard.logout}
						</button>
					</form>
				</nav>
			</aside>

			<div class="dash-main">
				<div class="dash-head">
					<div class="dash-head__avatar" aria-hidden="true">
					{guest.avatarUrl ? <img src={guest.avatarUrl} alt="" /> : initials}
				</div>
					<div>
						<h1>{copy.dashboard.welcome}, {guest.fullName}</h1>
						{memberSinceLabel && <p>{copy.dashboard.memberSince} {memberSinceLabel}</p>}
					</div>
				</div>

				<div class="stat-grid">
					<div class="stat-card">
						<div class="stat-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
								><path d="M20 7h-3V5a3 3 0 00-3-3h-4a3 3 0 00-3 3v2H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"></path><path
									d="M9 7V5a1 1 0 011-1h4a1 1 0 011 1v2"></path></svg
							>
						</div>
						<div>
							<p class="stat-num">{guest.isCompany ? copy.register.accountTypeCompany : copy.register.accountTypeIndividual}</p>
							<p class="stat-label">{copy.dashboard.accountType}</p>
						</div>
					</div>
					<div class="stat-card">
						<div class="stat-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
								><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg
							>
						</div>
						<div>
							<p class="stat-num stat-num--small">{guest.email}</p>
							<p class="stat-label">{copy.register.email}</p>
						</div>
					</div>
					<div class="stat-card">
						<div class="stat-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
								><path
									d="M22 16.92v3a2 2 0 01-2.18 2 19.8 19.8 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.36 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0122 16.92z"
								></path></svg
							>
						</div>
						<div>
							<p class="stat-num">{guest.phone}</p>
							<p class="stat-label">{copy.register.phone}</p>
						</div>
					</div>
				</div>

				<section id="account-details" class="section-card">
					<div class="section-head">
						<h2>{copy.dashboard.accountDetailsTitle}</h2>
					</div>
					<dl class="detail-grid">
						<div>
							<dt>{copy.register.fullName}</dt>
							<dd>{guest.fullName}</dd>
						</div>
						{
							guest.nationality && (
								<div>
									<dt>{copy.register.nationality}</dt>
									<dd>{countryLabel(guest.nationality)}</dd>
								</div>
							)
						}
						{
							guest.dateOfBirth && (
								<div>
									<dt>{copy.register.dateOfBirth}</dt>
									<dd>{formatDate(guest.dateOfBirth)}</dd>
								</div>
							)
						}
						{
							guest.addressLine && (
								<div>
									<dt>{copy.register.address}</dt>
									<dd>{guest.addressLine}</dd>
								</div>
							)
						}
						{
							guest.city && (
								<div>
									<dt>{copy.register.city}</dt>
									<dd>{guest.city}</dd>
								</div>
							)
						}
						{
							guest.postalCode && (
								<div>
									<dt>{copy.register.postalCode}</dt>
									<dd>{guest.postalCode}</dd>
								</div>
							)
						}
						{
							guest.countryOfResidence && (
								<div>
									<dt>{copy.register.countryOfResidence}</dt>
									<dd>{countryLabel(guest.countryOfResidence)}</dd>
								</div>
							)
						}
						<div>
							<dt>{copy.register.marketingConsent}</dt>
							<dd>{guest.marketingConsent ? copy.dashboard.yes : copy.dashboard.no}</dd>
						</div>
						{
							guest.isCompany && guest.companyName && (
								<div>
									<dt>{copy.register.companyName}</dt>
									<dd>{guest.companyName}</dd>
								</div>
							)
						}
						{
							guest.isCompany && guest.companyRegCode && (
								<div>
									<dt>{copy.register.companyRegCode}</dt>
									<dd>{guest.companyRegCode}</dd>
								</div>
							)
						}
						{
							guest.isCompany && guest.companyVat && (
								<div>
									<dt>{copy.register.companyVat}</dt>
									<dd>{guest.companyVat}</dd>
								</div>
							)
						}
						{
							guest.isCompany && guest.companyAddress && (
								<div>
									<dt>{copy.register.companyAddress}</dt>
									<dd>{guest.companyAddress}</dd>
								</div>
							)
						}
					</dl>
				</section>

				<section id="stay-history" class="section-card">
					<div class="section-head">
						<h2>{copy.dashboard.stayHistoryTitle}</h2>
					</div>
					{
						myBookings.length === 0 ? (
							<p class="empty-note">{copy.dashboard.stayHistoryEmpty}</p>
						) : (
							<ul class="booking-list">
								{myBookings.map((b) => (
									<li class="booking-item">
										<div class="booking-item__main">
											<p class="booking-item__room">{roomTitleFor(b.roomId)}</p>
											<p class="booking-item__dates">
												{b.checkIn} → {b.checkOut} · {b.nights} {bkCopy.page.summaryNights}
											</p>
										</div>
										<div class="booking-item__side">
											<p class="booking-item__total">
												{currency}
												{(b.totalCents / 100).toFixed(2)}
											</p>
											<div class="booking-item__badges">
												<span class={`bk-badge bk-badge--${b.status}`}>{bookingStatusLabels[b.status] ?? b.status}</span>
												<span class={`bk-badge ${b.paymentStatus === 'paid' ? 'bk-badge--paid' : ''}`}>{bookingPaymentLabels[b.paymentStatus] ?? b.paymentStatus}</span>
											</div>
										</div>
									</li>
								))}
							</ul>
						)
					}
				</section>
			</div>
		</div>
	</main>

	<SiteFooter locale={locale} />

	<style>
		.dash {
			background: var(--bg-light);
			color: var(--text-dark);
			padding: clamp(2rem, 4vw, 3rem) 0 clamp(3rem, 6vw, 5rem);
			min-height: 60vh;
		}

		.dash-shell {
			max-width: 68rem;
			margin: 0 auto;
			padding: 0 1.25rem;
			display: grid;
			grid-template-columns: 15rem 1fr;
			gap: 1.75rem;
			align-items: start;
		}

		/* ---------- Sidebar ---------- */
		.member-card {
			background: #fff;
			border: 1px solid var(--border-light);
			border-radius: 1rem;
			padding: 1.1rem;
			text-align: center;
			margin-bottom: 1.25rem;
		}

		.member-card__qr {
			display: flex;
			justify-content: center;
			margin-bottom: 0.6rem;
		}

		.member-card__qr :global(svg) {
			width: 9rem;
			height: 9rem;
		}

		.member-card__id {
			margin: 0 0 0.3rem;
			font-family: var(--font-display);
			font-weight: 600;
			font-size: 0.95rem;
			letter-spacing: 0.02em;
		}

		.member-card__note {
			margin: 0;
			font-size: 0.72rem;
			line-height: 1.4;
			color: var(--text-dark-muted);
		}

		.loyalty-card {
			background: linear-gradient(160deg, var(--bg-dark) 0%, var(--surface-dark-2) 100%);
			border-radius: 1rem;
			padding: 1.1rem 1.15rem;
			color: var(--cream);
			margin-bottom: 1.25rem;
		}

		.loyalty-card__label {
			margin: 0 0 0.3rem;
			font-size: 0.72rem;
			text-transform: uppercase;
			letter-spacing: 0.07em;
			color: var(--cream-muted);
		}

		.loyalty-card__points {
			font-family: var(--font-display);
			margin: 0 0 0.6rem;
			font-size: 1.9rem;
			font-weight: 600;
			display: flex;
			align-items: baseline;
			gap: 0.4rem;
		}

		.loyalty-card__points span {
			font-family: 'Inter Variable', sans-serif;
			font-size: 0.78rem;
			font-weight: 500;
			color: var(--accent);
		}

		.loyalty-card__note {
			margin: 0;
			font-size: 0.76rem;
			line-height: 1.5;
			color: var(--cream-muted);
		}

		.dash-nav {
			list-style: none;
			margin: 0 0 0.4rem;
			padding: 0;
		}

		.dash-nav li {
			margin-bottom: 0.15rem;
		}

		.dash-nav__link {
			display: flex;
			align-items: center;
			gap: 0.7rem;
			padding: 0.6rem 0.7rem;
			border-radius: 0.6rem;
			color: var(--text-dark-muted);
			text-decoration: none;
			font-size: 0.88rem;
			font-weight: 500;
			border: none;
			background: none;
			width: 100%;
			text-align: left;
			cursor: pointer;
			font-family: inherit;
		}

		.dash-nav__link svg {
			width: 17px;
			height: 17px;
			flex-shrink: 0;
		}

		.dash-nav__link:hover,
		.dash-nav__link.is-active {
			background: rgba(0, 114, 206, 0.08);
			color: var(--accent);
		}

		.dash-nav-divider {
			height: 1px;
			background: var(--border-light);
			margin: 0.6rem 0.4rem;
		}

		.dash-nav__logout:hover {
			background: rgba(179, 67, 47, 0.08);
			color: #b3432f;
		}

		.dash-nav__danger {
			color: #b3432f;
			text-decoration: none;
			font-size: 0.82rem;
			opacity: 0.85;
		}

		.dash-nav__danger:hover {
			background: rgba(179, 67, 47, 0.08);
			opacity: 1;
		}

		/* ---------- Main ---------- */
		.dash-head {
			display: flex;
			align-items: center;
			gap: 0.9rem;
			margin-bottom: 1.5rem;
		}

		.dash-head__avatar {
			width: 3rem;
			height: 3rem;
			border-radius: 50%;
			background: var(--accent);
			color: var(--accent-ink);
			font-family: var(--font-display);
			font-weight: 600;
			font-size: 1.1rem;
			display: flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
			overflow: hidden;
		}

		.dash-head__avatar img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.dash-head h1 {
			margin: 0 0 0.2rem;
			font-family: var(--font-display);
			font-size: clamp(1.3rem, 3vw, 1.7rem);
			font-weight: 600;
		}

		.dash-head p {
			margin: 0;
			font-size: 0.82rem;
			color: var(--text-dark-muted);
		}

		.stat-grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 0.9rem;
			margin-bottom: 1.25rem;
		}

		.stat-card {
			background: #fff;
			border: 1px solid var(--border-light);
			border-radius: 0.85rem;
			padding: 1rem 1.1rem;
			display: flex;
			align-items: flex-start;
			gap: 0.8rem;
			min-width: 0;
		}

		.stat-icon {
			width: 2.4rem;
			height: 2.4rem;
			border-radius: 0.6rem;
			background: rgba(0, 114, 206, 0.09);
			display: flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
			color: var(--accent);
		}

		.stat-icon svg {
			width: 18px;
			height: 18px;
		}

		.stat-num {
			margin: 0 0 0.1rem;
			font-weight: 700;
			font-size: 0.95rem;
			overflow-wrap: anywhere;
		}

		.stat-num--small {
			font-size: 0.85rem;
			font-weight: 600;
		}

		.stat-label {
			margin: 0;
			font-size: 0.76rem;
			color: var(--text-dark-muted);
		}

		.section-card {
			background: #fff;
			border: 1px solid var(--border-light);
			border-radius: 1rem;
			padding: 1.3rem 1.4rem;
			margin-bottom: 1.1rem;
			scroll-margin-top: 5.5rem;
		}

		.section-head {
			margin-bottom: 0.9rem;
		}

		.section-head h2 {
			font-family: var(--font-display);
			font-weight: 600;
