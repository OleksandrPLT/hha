---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { isLocale, defaultLocale, type Locale } from '../../../i18n/locales';
import { account } from '../../../i18n/account';
import { db } from '../../../db/client';
import { guests } from '../../../db/schema';
import { hashPassword } from '../../../lib/auth';
import { eq } from 'drizzle-orm';

const rawLocale = Astro.params.locale;
if (!rawLocale || !isLocale(rawLocale)) {
	return Astro.redirect(`/${defaultLocale}/account/reset-password`);
}
const locale: Locale = rawLocale;
const copy = account[locale].resetPassword;

const token = Astro.url.searchParams.get('token') || '';
let error = '';
let success = false;

function findGuestByToken(t: string) {
	if (!t) return null;
	const guest = db.select().from(guests).where(eq(guests.resetToken, t)).get();
	if (!guest || !guest.resetTokenExpiresAt) return null;
	if (new Date(guest.resetTokenExpiresAt).getTime() < Date.now()) return null;
	return guest;
}

const tokenGuest = findGuestByToken(token);

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const newPassword = String(form.get('newPassword') || '');
	const confirmPassword = String(form.get('confirmPassword') || '');

	if (!tokenGuest) {
		error = copy.errorInvalidToken;
	} else if (newPassword !== confirmPassword || newPassword.length < 8) {
		error = copy.errorMismatch;
	} else {
		const passwordHash = await hashPassword(newPassword);
		db.update(guests).set({ passwordHash, resetToken: null, resetTokenExpiresAt: null }).where(eq(guests.id, tokenGuest.id)).run();
		success = true;
	}
}
---

<BaseLayout locale={locale} title={`${copy.title} — Hostel & Hotel Apartments`} description={copy.title} path="/account/reset-password">
	<SiteHeader locale={locale} />

	<main class="modal-page">
		<a class="modal-page__scrim" href={`/${locale}`} aria-label="Close"></a>
		<div class="modal-page__card">
			<a class="modal-page__close" href={`/${locale}`} aria-label="Close">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
			</a>

			<h1>{copy.title}</h1>

			{
				success ? (
					<>
						<p class="success-message">{copy.successMessage}</p>
						<a class="btn btn--primary-dark" href={`/${locale}/account/login`}>
							{copy.loginLink}
						</a>
					</>
				) : !tokenGuest ? (
					<p class="form-error">{copy.errorInvalidToken}</p>
				) : (
					<>
						{error && <p class="form-error">{error}</p>}
						<form method="POST" class="account-form">
							<label>
								{copy.newPassword}
								<input type="password" name="newPassword" required minlength="8" />
							</label>
							<label>
								{copy.confirmPassword}
								<input type="password" name="confirmPassword" required minlength="8" />
							</label>
							<button type="submit" class="btn btn--primary-dark">
								{copy.submit}
							</button>
						</form>
					</>
				)
			}
		</div>
	</main>

	<SiteFooter locale={locale} />

	<style>
		.modal-page {
			position: relative;
			display: flex;
			align-items: flex-start;
			justify-content: center;
			padding: 3.5rem 1.25rem 4rem;
			background: var(--bg-light);
		}

		.modal-page__scrim {
			position: absolute;
			inset: 0;
			background: transparent;
		}

		.modal-page__card {
			position: relative;
			width: 100%;
			max-width: 22rem;
			background: #fff;
			color: var(--text-dark);
			border-radius: 1rem;
			padding: 1.75rem 1.5rem;
			border: 1px solid var(--border-light);
			box-shadow: 0 24px 60px rgba(20, 22, 26, 0.16);
			animation: modal-pop 0.16s ease;
		}

		@keyframes modal-pop {
			from {
				opacity: 0;
				transform: translateY(8px) scale(0.98);
			}
			to {
				opacity: 1;
				transform: translateY(0) scale(1);
			}
		}

		.modal-page__close {
			position: absolute;
			top: 0.85rem;
			right: 0.85rem;
			width: 2.1rem;
			height: 2.1rem;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			color: var(--text-dark-muted);
			text-decoration: none;
		}

		.modal-page__close:hover {
			background: rgba(0, 0, 0, 0.06);
			color: var(--text-dark);
		}

		h1 {
			margin: 0 0 1.25rem;
			font-size: clamp(1.3rem, 4vw, 1.6rem);
			font-weight: 800;
			padding-right: 1.75rem;
		}

		.success-message {
			font-size: 0.9rem;
			color: var(--text-dark);
			background: rgba(52, 168, 83, 0.1);
			border: 1px solid rgba(52, 168, 83, 0.3);
			border-radius: 0.6rem;
			padding: 0.9rem 1rem;
			margin: 0 0 1rem;
		}

		.form-error {
			background: rgba(234, 67, 53, 0.1);
			color: #c0392b;
			border: 1px solid rgba(234, 67, 53, 0.3);
			border-radius: 0.6rem;
			padding: 0.75rem 1rem;
			margin-bottom: 1.25rem;
			font-size: 0.9rem;
		}

		.account-form {
			display: flex;
			flex-direction: column;
			gap: 1.1rem;
		}

		.account-form label {
			display: flex;
			flex-direction: column;
			gap: 0.35rem;
			font-size: 0.85rem;
			font-weight: 600;
			color: var(--text-dark);
		}

		.account-form input {
			font: inherit;
			font-weight: 400;
			padding: 0.6rem 0.75rem;
			border-radius: 0.5rem;
			border: 1px solid var(--border-light);
			background: #fff;
			color: var(--text-dark);
		}
	</style>
</BaseLayout>
