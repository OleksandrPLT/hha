---
// Голий /account — тонкий редиректор на канонічний /account/<memberId>
// (щоб ID гостя був видно в адресному рядку, за проханням користувача
// 2026-08-30). Лишається як стабільна точка входу — на нього посилаються
// SiteHeader/AuthModal/AccountModal, де ще невідомо, хто саме залогінений
// (ті сторінки самі можуть бути пререндерені статично). Основний рендер
// кабінету — в [memberId].astro.
import { isLocale, defaultLocale, type Locale } from '../../../i18n/locales';
import { db } from '../../../db/client';
import { guests } from '../../../db/schema';
import { eq } from 'drizzle-orm';
import { formatMemberId } from '../../../lib/memberCard';

const rawLocale = Astro.params.locale;
if (!rawLocale || !isLocale(rawLocale)) {
	return Astro.redirect(`/${defaultLocale}/account`);
}
const locale: Locale = rawLocale;

const guestId = await Astro.session?.get('guestId');
if (!guestId) {
	return Astro.redirect(`/${locale}/account/login`);
}

const guest = db.select().from(guests).where(eq(guests.id, guestId)).get();
if (!guest) {
	return Astro.redirect(`/${locale}/account/login`);
}

return Astro.redirect(`/${locale}/account/${formatMemberId(guest.id)}`);
---
