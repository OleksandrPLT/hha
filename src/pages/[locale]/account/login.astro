---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { isLocale, defaultLocale, type Locale } from '../../../i18n/locales';
import { account } from '../../../i18n/account';
import { db } from '../../../db/client';
import { guests } from '../../../db/schema';
import { verifyPassword } from '../../../lib/auth';
import { formatMemberId } from '../../../lib/memberCard';
import { eq } from 'drizzle-orm';

const rawLocale = Astro.params.locale;
if (!rawLocale || !isLocale(rawLocale)) {
	return Astro.redirect(`/${defaultLocale}/account/login`);
}
const locale: Locale = rawLocale;
const copy = account[locale].login;

let error = '';
let emailValue = '';

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const email = String(form.get('email') || '')
		.trim()
		.toLowerCase();
	const password = String(form.get('password') || '');
	emailValue = email;

	const guest = db.select().from(guests).where(eq(guests.email, email)).get();
	if (!guest || !(await verifyPassword(password, guest.passwordHash))) {
		error = copy.errorInvalid;
	} else {
		await Astro.session?.set('guestId', guest.id);
		// Не чутлива мітка для клієнтського JS (сама сесія лишається httpOnly) —
		// щоб шапка/модалка знали, показувати "Sign in" чи "My account", не
		// звертаючись до сервера.
		Astro.cookies.set('hha_signed_in', '1', { path: '/', sameSite: 'lax', maxAge: 60 * 60 * 24 * 30 });
		return Astro.redirect(`/${locale}/account/${formatMemberId(guest.id)}`);
	}
}
---

<BaseLayout locale={locale} title={`${copy.title} — Hostel & Hotel Apartments`} description={copy.title} path="/account/login">
	<SiteHeader locale={locale} />

	<main class="modal-page">
		<a class="modal-page__scrim" href={`/${locale}`} aria-label="Close"></a>
		<div class="modal-page__card">
			<a class="modal-page__close" href={`/${locale}`} aria-label="Close">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
			</a>

			<h1>{copy.title}</h1>

			<div class="oauth-buttons">
				<button type="button" class="oauth-btn" disabled title="Coming soon">
					<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
						<path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z" />
						<path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z" />
						<path fill="#FBBC05" d="M3.964 10.71c-.18-.54-.282-1.117-.282-1.71s.102-1.17.282-1.71V4.958H.957C.347 6.173 0 7.548 0 9s.348 2.827.957 4.042l3.007-2.332z" />
						<path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z" />
					</svg>
					Google
				</button>
				<button type="button" class="oauth-btn" disabled title="Coming soon">
					<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="12" cy="12" r="12" fill="#26A5E4" />
						<path fill="#fff" d="M5.4 12.1l12-4.6c.6-.2 1.1.3.9 1l-2 9.3c-.1.5-.7.7-1.1.4l-3.1-2.3-1.5 1.4c-.2.2-.4.2-.6.1l.3-2.7 5.5-5-6.9 4.3-2.8-.9c-.6-.2-.6-.6.3-1z" />
					</svg>
					Telegram
				</button>
			</div>
			<p class="oauth-note">Coming soon</p>
			<div class="or-divider"><span>—</span></div>

			{error && <p class="form-error">{error}</p>}

			<form method="POST" class="account-form">
				<label>
					{copy.email}
					<input type="email" name="email" required value={emailValue} />
				</label>
				<label>
					{copy.password}
					<input type="password" name="password" required />
				</label>
				<a class="forgot-link" href={`/${locale}/account/forgot-password`}>{copy.forgotPassword}</a>
				<button type="submit" class="btn btn--primary-dark">{copy.submit}</button>
				<p class="form-footnote">
					{copy.noAccount} <a href={`/${locale}/account/register`}>{copy.registerLink}</a>
				</p>
			</form>
		</div>
	</main>

	<SiteFooter locale={locale} />

	<style>
		.modal-page {
			position: relative;
			min-height: 0;
			display: flex;
			align-items: flex-start;
			justify-content: center;
			padding: 3.5rem 1.25rem 4rem;
			background: var(--bg-light);
		}

		.modal-page__scrim {
			position: absolute;
			inset: 0;
			background: transparent;
		}

		.modal-page__card {
			position: relative;
			width: 100%;
			max-width: 22rem;
			background: #fff;
			color: var(--text-dark);
			border-radius: 1rem;
			padding: 1.75rem 1.5rem;
			border: 1px solid var(--border-light);
			box-shadow: 0 24px 60px rgba(20, 22, 26, 0.16);
			animation: modal-pop 0.16s ease;
		}

		@keyframes modal-pop {
			from {
				opacity: 0;
				transform: translateY(10px) scale(0.97);
			}
			to {
				opacity: 1;
				transform: translateY(0) scale(1);
			}
		}

		.modal-page__close {
			position: absolute;
			top: 0.9rem;
			right: 0.9rem;
			width: 2.1rem;
			height: 2.1rem;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			color: var(--text-dark-muted);
			text-decoration: none;
		}

		.modal-page__close:hover {
			background: rgba(0, 0, 0, 0.06);
			color: var(--text-dark);
		}

		h1 {
			margin: 0 0 1.5rem;
			font-size: clamp(1.4rem, 4vw, 1.8rem);
			font-weight: 800;
			padding-right: 2rem;
		}

		.form-error {
			background: rgba(234, 67, 53, 0.1);
			color: #c0392b;
			border: 1px solid rgba(234, 67, 53, 0.3);
			border-radius: 0.6rem;
			padding: 0.75rem 1rem;
			margin-bottom: 1.25rem;
			font-size: 0.9rem;
		}

		.account-form {
			display: flex;
			flex-direction: column;
			gap: 1.1rem;
		}

		.account-form label {
			display: flex;
			flex-direction: column;
			gap: 0.35rem;
			font-size: 0.85rem;
			font-weight: 600;
			color: var(--text-dark);
		}

		.account-form input {
			font: inherit;
			font-weight: 400;
			padding: 0.6rem 0.75rem;
			border-radius: 0.5rem;
			border: 1px solid var(--border-light);
			background: #fff;
			color: var(--text-dark);
		}

		.form-footnote {
			margin: 0.25rem 0 0;
			font-size: 0.85rem;
			color: var(--text-dark-muted);
		}

		.form-footnote a {
			color: var(--accent);
			font-weight: 600;
		}

		.forgot-link {
			align-self: flex-end;
			margin-top: -0.5rem;
			font-size: 0.78rem;
			color: var(--text-dark-muted);
			text-decoration: none;
		}

		.forgot-link:hover {
			color: var(--accent);
		}

		.oauth-buttons {
			display: flex;
			flex-direction: column;
			gap: 0.6rem;
			margin-bottom: 0.4rem;
		}

		.oauth-btn {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.6rem;
			font: inherit;
			font-weight: 600;
			font-size: 0.88rem;
			padding: 0.6rem 1rem;
			border-radius: 0.5rem;
			border: 1px solid var(--border-light);
			background: #fff;
			color: var(--text-dark);
			cursor: not-allowed;
			opacity: 0.55;
		}

		.oauth-note {
			margin: 0.4rem 0 0;
			text-align: center;
			font-size: 0.72rem;
			color: var(--text-dark-muted);
		}

		.or-divider {
			display: flex;
			align-items: center;
			margin: 1.1rem 0;
			color: var(--text-dark-muted);
			font-size: 0.75rem;
		}

		.or-divider::before,
		.or-divider::after {
			content: '';
			flex: 1;
			height: 1px;
			background: var(--border-light);
		}

		.or-divider span {
			padding: 0 0.6rem;
		}
	</style>
</BaseLayout>
