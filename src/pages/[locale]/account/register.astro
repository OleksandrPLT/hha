---
// Реальний SSR (немає prerender) — вимагає працюючого Node-процесу
// (PM2 на Zone.ee, див. пам'ять hha-hosting-infra). Локально в dev-режимі
// працює одразу.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import PhoneInput from '../../../components/PhoneInput.astro';
import { isLocale, defaultLocale, type Locale } from '../../../i18n/locales';
import { account } from '../../../i18n/account';
import { countries } from '../../../data/countries';
import { db } from '../../../db/client';
import { guests } from '../../../db/schema';
import { hashPassword, isValidEmail } from '../../../lib/auth';
import { eq } from 'drizzle-orm';

const rawLocale = Astro.params.locale;
if (!rawLocale || !isLocale(rawLocale)) {
	return Astro.redirect(`/${defaultLocale}/account/register`);
}
const locale: Locale = rawLocale;
const copy = account[locale].register;

let error = '';
let values: Record<string, string> = {};

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	values = Object.fromEntries([...form.entries()].map(([k, v]) => [k, String(v)]));

	const isCompany = form.get('accountType') === 'company';
	const fullName = String(form.get('fullName') || '').trim();
	const email = String(form.get('email') || '')
		.trim()
		.toLowerCase();
	const phoneCountry = String(form.get('phone_country') || '');
	const phoneNumber = String(form.get('phone') || '').trim();
	const password = String(form.get('password') || '');
	const confirmPassword = String(form.get('confirmPassword') || '');

	if (!fullName || !isValidEmail(email) || !phoneNumber || !password) {
		error = copy.errorGeneric;
	} else if (password !== confirmPassword) {
		error = copy.errorPasswordMismatch;
	} else {
		const existing = db.select().from(guests).where(eq(guests.email, email)).get();
		if (existing) {
			error = copy.errorEmailTaken;
		} else {
			const passwordHash = await hashPassword(password);
			const inserted = db
				.insert(guests)
				.values({
					fullName,
					email,
					phone: `${phoneCountry} ${phoneNumber}`,
					passwordHash,
					isCompany,
					companyName: isCompany ? String(form.get('companyName') || '') || null : null,
					companyRegCode: isCompany ? String(form.get('companyRegCode') || '') || null : null,
					companyVat: isCompany ? String(form.get('companyVat') || '') || null : null,
					companyAddress: isCompany ? String(form.get('companyAddress') || '') || null : null,
					nationality: String(form.get('nationality') || '') || null,
					dateOfBirth: String(form.get('dateOfBirth') || '') || null,
					addressLine: String(form.get('address') || '') || null,
					city: String(form.get('city') || '') || null,
					postalCode: String(form.get('postalCode') || '') || null,
					countryOfResidence: String(form.get('countryOfResidence') || '') || null,
					marketingConsent: form.get('marketingConsent') === 'on',
				})
				.run();

			await Astro.session?.set('guestId', Number(inserted.lastInsertRowid));
			Astro.cookies.set('hha_signed_in', '1', { path: '/', sameSite: 'lax', maxAge: 60 * 60 * 24 * 30 });
			return Astro.redirect(`/${locale}/account`);
		}
	}
}
---

<BaseLayout locale={locale} title={`${copy.title} — Hostel & Hotel Apartments`} description={copy.subtitle} path="/account/register">
	<SiteHeader locale={locale} />

	<main class="modal-page">
		<a class="modal-page__scrim" href={`/${locale}`} aria-label="Close"></a>
		<div class="modal-page__card">
			<a class="modal-page__close" href={`/${locale}`} aria-label="Close">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
			</a>

			<h1>{copy.title}</h1>
			<p class="subtitle">{copy.subtitle}</p>

			<div class="oauth-buttons">
				<button type="button" class="oauth-btn" disabled title="Coming soon">
					<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
						<path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z" />
						<path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z" />
						<path fill="#FBBC05" d="M3.964 10.71c-.18-.54-.282-1.117-.282-1.71s.102-1.17.282-1.71V4.958H.957C.347 6.173 0 7.548 0 9s.348 2.827.957 4.042l3.007-2.332z" />
						<path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z" />
					</svg>
					Google
				</button>
				<button type="button" class="oauth-btn" disabled title="Coming soon">
					<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="12" cy="12" r="12" fill="#26A5E4" />
						<path fill="#fff" d="M5.4 12.1l12-4.6c.6-.2 1.1.3.9 1l-2 9.3c-.1.5-.7.7-1.1.4l-3.1-2.3-1.5 1.4c-.2.2-.4.2-.6.1l.3-2.7 5.5-5-6.9 4.3-2.8-.9c-.6-.2-.6-.6.3-1z" />
					</svg>
					Telegram
				</button>
			</div>
			<p class="oauth-note">Coming soon</p>
			<div class="or-divider"><span>—</span></div>

			{error && <p class="form-error">{error}</p>}

			<form method="POST" class="account-form" id="register-form">
				<div class="account-type-toggle">
					<label>
						<input type="radio" name="accountType" value="individual" checked={values.accountType !== 'company'} />
						{copy.accountTypeIndividual}
					</label>
					<label>
						<input type="radio" name="accountType" value="company" checked={values.accountType === 'company'} />
						{copy.accountTypeCompany}
					</label>
				</div>

				<div class="company-fields" id="company-fields" hidden>
					<label>
						{copy.companyName}
						<input type="text" name="companyName" value={values.companyName ?? ''} />
					</label>
					<label>
						{copy.companyRegCode}
						<input type="text" name="companyRegCode" value={values.companyRegCode ?? ''} />
					</label>
					<label>
						{copy.companyVat}
						<input type="text" name="companyVat" value={values.companyVat ?? ''} />
					</label>
					<label>
						{copy.companyAddress}
						<input type="text" name="companyAddress" value={values.companyAddress ?? ''} />
					</label>
					<p class="field-note">{copy.companyLookupNote}</p>
				</div>

				<label>
					{copy.fullName}
					<input type="text" name="fullName" required value={values.fullName ?? ''} />
				</label>

				<label>
					{copy.email}
					<input type="email" name="email" required value={values.email ?? ''} />
				</label>

				<label>
					{copy.phone}
					<PhoneInput name="phone" required value={values.phone} countryValue={values.phone_country} />
				</label>

				<div class="field-row">
					<label>
						{copy.password}
						<input type="password" name="password" required minlength="8" />
					</label>
					<label>
						{copy.confirmPassword}
						<input type="password" name="confirmPassword" required minlength="8" />
					</label>
				</div>

				<div class="field-row">
					<label>
						{copy.nationality}
						<select name="nationality">
							<option value="">—</option>
							{countries.map((c) => <option value={c.iso2} selected={values.nationality === c.iso2}>{c.name}</option>)}
						</select>
					</label>
					<label>
						{copy.dateOfBirth}
						<input type="date" name="dateOfBirth" value={values.dateOfBirth ?? ''} />
					</label>
				</div>

				<label>
					{copy.address}
					<input type="text" name="address" value={values.address ?? ''} />
				</label>

				<div class="field-row">
					<label>
						{copy.city}
						<input type="text" name="city" value={values.city ?? ''} />
					</label>
					<label>
						{copy.postalCode}
						<input type="text" name="postalCode" value={values.postalCode ?? ''} />
					</label>
				</div>

				<label>
					{copy.countryOfResidence}
					<select name="countryOfResidence">
						<option value="">—</option>
						{countries.map((c) => <option value={c.iso2} selected={values.countryOfResidence === c.iso2}>{c.name}</option>)}
					</select>
				</label>

				<label class="checkbox-row">
					<input type="checkbox" name="marketingConsent" checked={values.marketingConsent === 'on'} />
					{copy.marketingConsent}
				</label>

				<button type="submit" class="btn btn--primary-dark">{copy.submit}</button>

				<p class="form-footnote">
					{copy.haveAccount} <a href={`/${locale}/account/login`}>{copy.loginLink}</a>
				</p>
			</form>
		</div>
	</main>

	<SiteFooter locale={locale} />

	<script is:inline>
		(function () {
			var radios = document.querySelectorAll('input[name="accountType"]');
			var companyFields = document.getElementById('company-fields');
			function sync() {
				var isCompany = document.querySelector('input[name="accountType"]:checked')?.value === 'company';
				if (companyFields) companyFields.hidden = !isCompany;
			}
			radios.forEach(function (r) {
				r.addEventListener('change', sync);
			});
			sync();
		})();
	</script>

	<style>
		.modal-page {
			position: relative;
			display: flex;
			align-items: flex-start;
			justify-content: center;
			padding: 3rem 1.25rem 4rem;
			background: var(--bg-dark);
			overflow: hidden;
		}

		.modal-page__scrim {
			position: absolute;
			inset: 0;
			background: radial-gradient(circle at 50% 15%, rgba(0, 114, 206, 0.22), transparent 55%);
			filter: blur(40px);
		}

		.modal-page__card {
			position: relative;
			width: 100%;
			max-width: 28rem;
			background: #fff;
			color: var(--text-dark);
			border-radius: 1rem;
			padding: 1.75rem 1.5rem;
			border: 1px solid var(--border-light);
			box-shadow: 0 24px 60px rgba(20, 22, 26, 0.16);
			animation: modal-pop 0.16s ease;
		}

		@keyframes modal-pop {
			from {
				opacity: 0;
				transform: translateY(8px) scale(0.98);
			}
			to {
				opacity: 1;
				transform: translateY(0) scale(1);
			}
		}

		.modal-page__close {
			position: absolute;
			top: 0.85rem;
			right: 0.85rem;
			width: 2.1rem;
			height: 2.1rem;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			color: var(--text-dark-muted);
			text-decoration: none;
		}

		.modal-page__close:hover {
			background: rgba(0, 0, 0, 0.06);
			color: var(--text-dark);
		}

		h1 {
			margin: 0 0 0.4rem;
			font-size: clamp(1.3rem, 4vw, 1.6rem);
			font-weight: 800;
			padding-right: 1.75rem;
		}

		.subtitle {
			margin: 0 0 1.5rem;
			font-size: 0.88rem;
			color: var(--text-dark-muted);
		}

		.form-error {
			background: rgba(234, 67, 53, 0.1);
			color: #c0392b;
			border: 1px solid rgba(234, 67, 53, 0.3);
			border-radius: 0.6rem;
			padding: 0.75rem 1rem;
			margin-bottom: 1.25rem;
			font-size: 0.9rem;
		}

		.account-form {
			display: flex;
			flex-direction: column;
			gap: 1.1rem;
		}

		.account-form label {
			display: flex;
			flex-direction: column;
			gap: 0.35rem;
			font-size: 0.85rem;
			font-weight: 600;
			color: var(--text-dark);
		}

		.account-form input[type='text'],
		.account-form input[type='email'],
		.account-form input[type='password'],
		.account-form input[type='date'],
		.account-form select {
			font: inherit;
			font-weight: 400;
			padding: 0.6rem 0.75rem;
			border-radius: 0.5rem;
			border: 1px solid var(--border-light);
			background: #fff;
			color: var(--text-dark);
		}

		.field-row {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 1rem;
		}

		.account-type-toggle {
			display: flex;
			gap: 1rem;
			padding: 0.9rem 1rem;
			background: #fff;
			border: 1px solid var(--border-light);
			border-radius: 0.6rem;
		}

		.account-type-toggle label {
			flex-direction: row;
			align-items: center;
			gap: 0.4rem;
			font-weight: 600;
		}

		/* :not([hidden]) — інакше та ж помилка, що з LanguageModal: наше
		   display:flex перебиває UA-правило [hidden]{display:none} через
		   однакову специфічність і порядок джерел. */
		.company-fields:not([hidden]) {
			display: flex;
			flex-direction: column;
			gap: 0.9rem;
			padding: 1rem;
			border: 1px dashed var(--border-light);
			border-radius: 0.6rem;
			background: rgba(0, 114, 206, 0.04);
		}

		.field-note {
			margin: 0;
			font-size: 0.78rem;
			font-weight: 400;
			color: var(--text-dark-muted);
		}

		.checkbox-row {
			flex-direction: row;
			align-items: flex-start;
			gap: 0.5rem;
			font-weight: 400;
			font-size: 0.85rem;
			color: var(--text-dark-muted);
		}

		.checkbox-row input {
			margin-top: 0.2rem;
		}

		.form-footnote {
			margin: 0.25rem 0 0;
			font-size: 0.85rem;
			color: var(--text-dark-muted);
		}

		.form-footnote a {
			color: var(--accent);
			font-weight: 600;
		}

		@media (max-width: 560px) {
			.field-row {
				grid-template-columns: 1fr;
			}
		}
	</style>
</BaseLayout>
