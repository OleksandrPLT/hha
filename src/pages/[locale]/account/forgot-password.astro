---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { isLocale, defaultLocale, type Locale } from '../../../i18n/locales';
import { account } from '../../../i18n/account';
import { db } from '../../../db/client';
import { guests } from '../../../db/schema';
import { generateResetToken } from '../../../lib/auth';
import { sendMail } from '../../../lib/mailer';
import { eq } from 'drizzle-orm';

const rawLocale = Astro.params.locale;
if (!rawLocale || !isLocale(rawLocale)) {
	return Astro.redirect(`/${defaultLocale}/account/forgot-password`);
}
const locale: Locale = rawLocale;
const copy = account[locale].forgotPassword;

let submitted = false;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const email = String(form.get('email') || '')
		.trim()
		.toLowerCase();

	const guest = db.select().from(guests).where(eq(guests.email, email)).get();
	if (guest) {
		const token = generateResetToken();
		const expiresAt = new Date(Date.now() + 60 * 60 * 1000).toISOString(); // 1 година
		db.update(guests).set({ resetToken: token, resetTokenExpiresAt: expiresAt }).where(eq(guests.id, guest.id)).run();

		const resetUrl = new URL(`/${locale}/account/reset-password?token=${token}`, Astro.site).toString();
		try {
			await sendMail(
				guest.email,
				'Hostel 3A — password reset',
				`<p>Hi ${guest.fullName},</p><p>Click the link below to set a new password (valid for 1 hour):</p><p><a href="${resetUrl}">${resetUrl}</a></p><p>If you didn't request this, ignore this email.</p>`
			);
		} catch (e) {
			// SMTP ще не налаштований або впав — не валимо форму помилкою 500,
			// просто логуємо на сервері; гість все одно бачить нейтральне
			// повідомлення (щоб не розкривати, чи є такий email в базі).
			console.error('[forgot-password] sendMail failed:', e);
		}
	}
	// Завжди однакова відповідь, є email в базі чи ні — не даємо перевіряти
	// зареєстровані адреси перебором.
	submitted = true;
}
---

<BaseLayout locale={locale} title={`${copy.title} — Hostel & Hotel Apartments`} description={copy.subtitle} path="/account/forgot-password">
	<SiteHeader locale={locale} />

	<main class="modal-page">
		<a class="modal-page__scrim" href={`/${locale}`} aria-label="Close"></a>
		<div class="modal-page__card">
			<a class="modal-page__close" href={`/${locale}`} aria-label="Close">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
			</a>

			<h1>{copy.title}</h1>

			{
				submitted ? (
					<>
						<p class="success-message">{copy.successMessage}</p>
						<p class="form-footnote">
							<a href={`/${locale}/account/login`}>{copy.backToLogin}</a>
						</p>
					</>
				) : (
					<>
						<p class="subtitle">{copy.subtitle}</p>
						<form method="POST" class="account-form">
							<label>
								{copy.email}
								<input type="email" name="email" required />
							</label>
							<button type="submit" class="btn btn--primary-dark">
								{copy.submit}
							</button>
							<p class="form-footnote">
								<a href={`/${locale}/account/login`}>{copy.backToLogin}</a>
							</p>
						</form>
					</>
				)
			}
		</div>
	</main>

	<SiteFooter locale={locale} />

	<style>
		.modal-page {
			position: relative;
			display: flex;
			align-items: flex-start;
			justify-content: center;
			padding: 3.5rem 1.25rem 4rem;
			background: var(--bg-light);
		}

		.modal-page__scrim {
			position: absolute;
			inset: 0;
			background: transparent;
		}

		.modal-page__card {
			position: relative;
			width: 100%;
			max-width: 22rem;
			background: #fff;
			color: var(--text-dark);
			border-radius: 1rem;
			padding: 1.75rem 1.5rem;
			border: 1px solid var(--border-light);
			box-shadow: 0 24px 60px rgba(20, 22, 26, 0.16);
			animation: modal-pop 0.16s ease;
		}

		@keyframes modal-pop {
			from {
				opacity: 0;
				transform: translateY(8px) scale(0.98);
			}
			to {
				opacity: 1;
				transform: translateY(0) scale(1);
			}
		}

		.modal-page__close {
			position: absolute;
			top: 0.85rem;
			right: 0.85rem;
			width: 2.1rem;
			height: 2.1rem;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			color: var(--text-dark-muted);
			text-decoration: none;
		}

		.modal-page__close:hover {
			background: rgba(0, 0, 0, 0.06);
			color: var(--text-dark);
		}

		h1 {
			margin: 0 0 0.4rem;
			font-size: clamp(1.3rem, 4vw, 1.6rem);
			font-weight: 800;
			padding-right: 1.75rem;
		}

		.subtitle {
			margin: 0 0 1.5rem;
			font-size: 0.88rem;
			color: var(--text-dark-muted);
		}

		.success-message {
			font-size: 0.9rem;
			color: var(--text-dark);
			background: rgba(52, 168, 83, 0.1);
			border: 1px solid rgba(52, 168, 83, 0.3);
			border-radius: 0.6rem;
			padding: 0.9rem 1rem;
			margin: 0 0 1rem;
		}

		.account-form {
			display: flex;
			flex-direction: column;
			gap: 1.1rem;
		}

		.account-form label {
			display: flex;
			flex-direction: column;
			gap: 0.35rem;
			font-size: 0.85rem;
			font-weight: 600;
			color: var(--text-dark);
		}

		.account-form input {
			font: inherit;
			font-weight: 400;
			padding: 0.6rem 0.75rem;
			border-radius: 0.5rem;
			border: 1px solid var(--border-light);
			background: #fff;
			color: var(--text-dark);
		}

		.form-footnote {
			margin: 0;
			font-size: 0.83rem;
			text-align: center;
		}

		.form-footnote a {
			color: var(--accent);
			font-weight: 600;
		}
	</style>
</BaseLayout>
