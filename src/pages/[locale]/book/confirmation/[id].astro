---
// Фаза 4 — сторінка підтвердження бронювання. Доступ обмежений: власник
// сесії (guestId збігається) АБО щойно створив цю бронь у цій самій сесії
// (lastBookingId, встановлюється в [slug].astro перед редіректом) — інакше
// будь-хто міг би переглядати чужі брони, підбираючи id в URL.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooter from '../../../../components/SiteFooter.astro';
import { isLocale, defaultLocale, type Locale } from '../../../../i18n/locales';
import { booking as bookingCopy } from '../../../../i18n/booking';
import { db } from '../../../../db/client';
import { bookings, rooms } from '../../../../db/schema';
import { eq } from 'drizzle-orm';
import { isRevolutConfigured } from '../../../../lib/revolut';
import { formatBookingRef } from '../../../../lib/memberCard';
import { currency } from '../../../../data/pricing';

export const prerender = false;

const rawLocale = Astro.params.locale;
if (!rawLocale || !isLocale(rawLocale)) {
	return Astro.redirect(`/${defaultLocale}`);
}
const locale: Locale = rawLocale;
const copy = bookingCopy[locale].confirmation;

const bookingId = Number(Astro.params.id);
if (!Number.isInteger(bookingId)) {
	return Astro.redirect(`/${locale}`);
}

const bk = db.select().from(bookings).where(eq(bookings.id, bookingId)).get();
if (!bk) {
	return Astro.redirect(`/${locale}`);
}

const sessionGuestId = await Astro.session?.get('guestId');
const lastBookingId = await Astro.session?.get('lastBookingId');
const isOwner = (sessionGuestId && sessionGuestId === bk.guestId) || lastBookingId === bk.id;
if (!isOwner) {
	return Astro.redirect(`/${locale}`);
}

const room = db.select().from(rooms).where(eq(rooms.id, bk.roomId)).get();
function pickLocale(json: string | undefined): string {
	if (!json) return '';
	try {
		const parsed = JSON.parse(json) as Record<string, string>;
		return parsed[locale] ?? parsed.en ?? '';
	} catch {
		return '';
	}
}
const roomTitle = room ? pickLocale(room.titles) : '';

const needsPayment = bk.paymentMethod === 'revolut' && bk.paymentStatus !== 'paid';
const revolutReady = isRevolutConfigured() && Boolean(bk.paymentRef) && Boolean(bk.paymentCheckoutUrl);
---

<BaseLayout locale={locale} title={copy.heading} description={bookingCopy[locale].meta.description} path={`/book/confirmation/${bookingId}`}>
	<SiteHeader locale={locale} />

	<main class="confirmation-page">
		<div class="container">
			<div class="confirmation-card">
				<h1>{copy.heading}</h1>
				<p class="subtitle">{copy.subheading}</p>

				<dl class="details">
					<div><dt>{copy.refLabel}</dt><dd>{formatBookingRef(bk.id)}</dd></div>
					<div><dt>{bookingCopy[locale].page.roomLabel}</dt><dd>{roomTitle}</dd></div>
					<div><dt>{bookingCopy[locale].page.checkIn}</dt><dd>{bk.checkIn}</dd></div>
					<div><dt>{bookingCopy[locale].page.checkOut}</dt><dd>{bk.checkOut}</dd></div>
					{bk.discountCents > 0 && (
						<div><dt>{bookingCopy[locale].page.discountLabel}</dt><dd>−{currency}{(bk.discountCents / 100).toFixed(2)}</dd></div>
					)}
					<div><dt>{bookingCopy[locale].page.summaryTotal}</dt><dd>{currency}{(bk.totalCents / 100).toFixed(2)}</dd></div>
				</dl>

				<p class="status-badge" class:list={[bk.status === 'confirmed' ? 'is-confirmed' : 'is-pending']}>
					{bk.status === 'confirmed' ? copy.statusConfirmed : copy.statusPending}
				</p>

				{
					needsPayment && revolutReady ? (
						<div class="pay-box">
							<a href={bk.paymentCheckoutUrl!} id="revolut-pay-btn" class="btn btn--primary-dark">
								{bookingCopy[locale].page.paymentRevolut}
							</a>
							<button type="button" id="revolut-check-btn" class="btn btn--ghost-dark">
								{copy.checkStatusBtn}
							</button>
							<p id="pay-status" class="pay-status" hidden></p>
						</div>
					) : needsPayment ? (
						<p class="note">{copy.payAtCheckinNote}</p>
					) : (
						<p class="note">{copy.paidNote}</p>
					)
				}

				<p class="note">{copy.emailSent}</p>
				<p class="note">{copy.pointsNote}</p>

				<a href={`/${locale}`} class="btn btn--ghost-dark">{copy.backHome}</a>
			</div>
		</div>
	</main>

	<SiteFooter locale={locale} />

	<script
		define:vars={{
			bookingId: bk.id,
			bookingRef: `BK-${String(bk.id).padStart(6, '0')}`,
			roomSlug: room?.slug ?? '',
			roomTitle,
			nights: bk.nights,
			guestsCount: bk.guestsCount,
			pricePerNight: bk.pricePerNightCents / 100,
			totalValue: bk.totalCents / 100,
			paymentMethod: bk.paymentMethod,
			paymentStatus: bk.paymentStatus,
			bookingSource: bk.source,
			locale,
		}}
	>
		// GTM/GA4 — детальні події конверсії (за проханням користувача
		// 2026-08-30). booking_confirmed фіксує саму бронь як лід (незалежно
		// від методу оплати); purchase — тільки коли оплату реально
		// підтверджено (Revolut real-time, або "на місці" вже позначено
		// оплаченим адміном). Дедуп через localStorage — сторінка може
		// перезавантажуватись (авточек статусу оплати), подія не повинна
		// рахуватись двічі.
		window.dataLayer = window.dataLayer || [];

		function pushOnce(key, payload) {
			const flagKey = 'hha_gtm_' + key + '_' + bookingId;
			if (localStorage.getItem(flagKey)) return;
			window.dataLayer.push(payload);
			try {
				localStorage.setItem(flagKey, '1');
			} catch {
				// приватний режим / заблоковане сховище — подія все одно пішла, просто без дедупу наступного разу
			}
		}

		const item = {
			item_id: roomSlug,
			item_name: roomTitle,
			item_category: 'room',
			price: pricePerNight,
			quantity: nights,
		};

		pushOnce('booking_confirmed', {
			event: 'booking_confirmed',
			transaction_id: bookingRef,
			value: totalValue,
			currency: 'EUR',
			payment_method: paymentMethod,
			booking_source: bookingSource,
			nights,
			guests_count: guestsCount,
			locale,
			items: [item],
		});

		if (paymentStatus === 'paid') {
			pushOnce('purchase', {
				event: 'purchase',
				ecommerce: {
					transaction_id: bookingRef,
					value: totalValue,
					currency: 'EUR',
					payment_type: paymentMethod,
					items: [item],
				},
				booking_source: bookingSource,
				nights,
				guests_count: guestsCount,
				locale,
			});
		}
	</script>

	{
		needsPayment && revolutReady && (
			<script define:vars={{ bookingId: bk.id }}>
				// Оплата йде на хостованій сторінці Revolut (окрема вкладка), не в
				// embed-попапі (той відкривався порожнім — hha.ee, ймовірно, не
				// зареєстрований як embed-домен в Revolut Business). Реальна
				// оплата може зайняти хвилини (ручне введення картки, 3DS і т.д.),
				// тому: (1) перевіряємо статус одразу при завантаженні сторінки —
				// покриває випадок "гість оплатив і повернувся пізніше", (2) після
				// кліку по кнопці оплати опитуємо довго (до ~20 хв), (3) є ручна
				// кнопка "перевірити зараз" як підстраховка, якщо і це не встигло.
				const btn = document.getElementById('revolut-pay-btn');
				const checkBtn = document.getElementById('revolut-check-btn');
				const statusEl = document.getElementById('pay-status');
				let polling = false;

				async function pollOnce() {
					try {
						const res = await fetch('/api/booking/confirm-payment', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ bookingId }),
						});
						const data = await res.json();
						return Boolean(data.paid);
					} catch {
						return false;
					}
				}

				function startPolling(intervalMs, maxAttempts) {
					if (polling) return;
					polling = true;
					statusEl.hidden = false;
					statusEl.textContent = 'Waiting for payment confirmation…';
					let attempts = 0;
					const interval = setInterval(async () => {
						attempts++;
						const paid = await pollOnce();
						if (paid) {
							clearInterval(interval);
							window.location.reload();
						} else if (attempts >= maxAttempts) {
							clearInterval(interval);
							statusEl.textContent = 'Not confirmed yet — pay in the tab that opened, then use "Check payment status".';
							polling = false;
						}
					}, intervalMs);
				}

				// (1) одноразова перевірка одразу — раптом гість вже оплатив і
				// просто повернувся/оновив сторінку.
				pollOnce().then((paid) => {
					if (paid) window.location.reload();
				});

				// (2) довге опитування після кліку "Оплатити".
				btn?.addEventListener('click', () => startPolling(5000, 240));

				// (3) ручна перевірка на вимогу.
				checkBtn?.addEventListener('click', async () => {
					statusEl.hidden = false;
					statusEl.textContent = 'Checking…';
					const paid = await pollOnce();
					if (paid) {
						window.location.reload();
					} else {
						statusEl.textContent = 'Not paid yet.';
					}
				});
			</script>
		)
	}

	<style>
		.confirmation-page {
			background: var(--bg-light);
			min-height: 70vh;
			padding: 3rem 0 4rem;
		}

		.container {
			max-width: 32rem;
			margin: 0 auto;
			padding: 0 1.25rem;
		}

		.confirmation-card {
			background: #fff;
			border: 1px solid var(--border-light);
			border-radius: 1rem;
			padding: 2rem 1.75rem;
			text-align: center;
		}

		h1 {
			margin: 0 0 0.4rem;
			font-size: clamp(1.4rem, 4vw, 1.8rem);
			font-weight: 800;
		}

		.subtitle {
			margin: 0 0 1.5rem;
			color: var(--text-dark-muted);
			font-size: 0.92rem;
		}

		.details {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			text-align: left;
			background: var(--bg-light);
			border-radius: 0.7rem;
			padding: 1rem 1.1rem;
			margin: 0 0 1rem;
		}

		.details div {
			display: flex;
			justify-content: space-between;
			font-size: 0.88rem;
		}

		.details dt {
			color: var(--text-dark-muted);
			font-weight: 400;
		}

		.details dd {
			margin: 0;
			font-weight: 700;
		}

		.status-badge {
			display: inline-block;
			padding: 0.3rem 0.8rem;
			border-radius: 999px;
			font-size: 0.78rem;
			font-weight: 700;
			margin: 0 0 1.25rem;
		}

		.status-badge.is-pending {
			background: rgba(210, 150, 40, 0.14);
			color: #a16a1a;
		}

		.status-badge.is-confirmed {
			background: rgba(63, 122, 79, 0.14);
			color: #2e7d4f;
		}

		.pay-box {
			margin-bottom: 1.25rem;
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
		}

		.pay-status {
			margin: 0.6rem 0 0;
			font-size: 0.82rem;
			color: var(--text-dark-muted);
		}

		.note {
			margin: 0 0 0.6rem;
			font-size: 0.85rem;
			color: var(--text-dark-muted);
		}

		.btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			padding: 0.75rem 1.2rem;
			border-radius: 0.6rem;
			font-weight: 700;
			font-size: 0.9rem;
			font-family: inherit;
			border: none;
			cursor: pointer;
			text-decoration: none;
			width: 100%;
		}

		.btn--primary-dark {
			background: var(--text-dark);
			color: var(--bg-light);
		}

		.btn--primary-dark:hover {
			filter: brightness(1.2);
		}

		.btn--ghost-dark {
			border: 1px solid var(--border-light);
			color: var(--text-dark);
			margin-top: 0.5rem;
		}

		.btn--ghost-dark:hover {
			border-color: var(--accent);
			color: var(--accent);
		}
	</style>
</BaseLayout>
