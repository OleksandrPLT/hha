		}

		.hero__scrim {
			position: absolute;
			inset: 0;
			background: linear-gradient(0deg, rgba(11, 13, 18, 0.92) 0%, rgba(11, 13, 18, 0.55) 45%, rgba(11, 13, 18, 0.25) 100%);
		}

		.hero__content {
			position: relative;
			max-width: 72rem;
			margin: 0 auto;
			padding: 3rem 1.25rem 3.5rem;
			color: var(--cream);
		}

		.hero h1 {
			font-family: var(--font-display);
			margin: 0.4rem 0 1rem;
			font-size: clamp(2rem, 5vw, 3.25rem);
			font-weight: 600;
			letter-spacing: -0.01em;
			max-width: 40rem;
		}

		.hero__subheading {
			margin: 0 0 1.75rem;
			max-width: 34rem;
			font-size: clamp(1rem, 1.6vw, 1.15rem);
			color: var(--cream-muted);
			line-height: 1.55;
		}

		.hero__actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.85rem;
		}

		.eyebrow {
			margin: 0;
			font-size: 0.75rem;
			font-weight: 700;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			color: var(--text-dark-muted);
		}

		.eyebrow--dark {
			color: var(--accent);
		}

		.container {
			max-width: 72rem;
			margin: 0 auto;
			padding: 0 1.25rem;
		}

		.section {
			padding: clamp(3.5rem, 7vw, 6rem) 0;
		}

		.section--light {
			background: var(--bg-light);
			color: var(--text-dark);
		}

		.section--dark {
			background: var(--bg-dark);
			color: var(--cream);
		}

		.section--light h2 {
			color: var(--text-dark);
		}

		.heading--dark {
			color: var(--cream);
		}

		h2 {
			font-family: var(--font-display);
			margin: 0.5rem 0 1rem;
			font-size: clamp(1.6rem, 3.2vw, 2.25rem);
			font-weight: 600;
			letter-spacing: -0.01em;
		}

		.body-text {
			margin: 0;
			line-height: 1.65;
			color: var(--text-dark-muted);
			max-width: 40rem;
		}

		.body-text--dark {
			color: var(--cream-muted);
		}

		.section-subheading {
			margin-bottom: 2.5rem;
		}

		.btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			padding: 0.8rem 1.4rem;
			border-radius: 0.6rem;
			font-weight: 700;
			font-size: 0.92rem;
			text-decoration: none;
			transition: filter 0.15s ease, background 0.15s ease, color 0.15s ease;
		}

		.btn--primary {
			background: var(--accent);
			color: var(--accent-ink);
		}

		.btn--primary:hover {
			filter: brightness(1.08);
		}

		.btn--ghost {
			border: 1px solid rgba(245, 240, 230, 0.35);
			color: var(--cream);
		}

		.btn--ghost:hover {
			border-color: var(--accent);
			color: var(--accent);
		}

		.btn--primary-dark {
			background: var(--text-dark);
			color: var(--bg-light);
			margin-top: 0.5rem;
		}

		.btn--primary-dark:hover {
			filter: brightness(1.2);
		}

		/* About */
		.about {
			display: grid;
			grid-template-columns: 1.1fr 0.9fr;
			gap: 3rem;
			align-items: center;
		}

		.about__image :global(img) {
			width: 100%;
			height: 22rem;
			object-fit: cover;
			border-radius: 1rem;
			display: block;
		}

		/* Rooms */
		.room-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
			gap: 1.75rem;
		}

		.room-card {
			background: var(--surface-dark);
			border: 1px solid var(--border-dark);
			border-radius: 1rem;
			overflow: hidden;
			cursor: pointer;
			display: flex;
			flex-direction: column;
			height: 100%;
			transition: border-color 0.15s ease, transform 0.15s ease;
		}

		.room-card:hover,
		.room-card:focus-visible {
			border-color: var(--accent);
			transform: translateY(-2px);
		}

		.room-card:focus-visible {
			outline: 2px solid var(--accent);
			outline-offset: 2px;
		}

		/* Модалка деталей номера */
		.room-modal:not([hidden]) {
			position: fixed;
			inset: 0;
			z-index: 150;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 1.25rem;
		}

		.room-modal__scrim {
			position: absolute;
			inset: 0;
			background: rgba(11, 13, 16, 0.78);
			backdrop-filter: blur(6px);
		}

		.room-modal__dialog {
			position: relative;
			width: 100%;
			max-width: 46rem;
			max-height: 88vh;
			overflow-y: auto;
			background: var(--surface-dark);
			border: 1px solid var(--border-dark);
			border-radius: 1.25rem;
			box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
		}

		.room-modal__close {
			position: absolute;
			top: 0.9rem;
			right: 0.9rem;
			z-index: 1;
			width: 2.25rem;
			height: 2.25rem;
			border-radius: 50%;
			border: 1px solid var(--border-dark);
			background: var(--surface-dark-2);
			color: var(--cream);
			display: flex;
			align-items: center;
			justify-content: center;
			cursor: pointer;
		}

		.room-modal__close:hover {
			border-color: var(--accent);
			color: var(--accent);
		}

		.room-modal__panel:not([hidden]) {
			display: block;
		}

		.room-modal__img :global(img) {
			width: 100%;
			height: 18rem;
			object-fit: cover;
			display: block;
			border-radius: 1.25rem 1.25rem 0 0;
		}

		.room-modal__body {
			padding: 1.5rem;
		}

		.room-modal__body h3 {
			margin: 0 0 0.4rem;
			font-size: 1.3rem;
			font-weight: 800;
			color: var(--cream);
		}

		.room-modal__meta {
			margin: 0 0 1rem;
			font-size: 0.9rem;
			color: var(--cream-muted);
		}

		.room-modal__body .room-card__price {
			margin: 0 0 0.2rem;
		}

		.room-modal__body .room-card__vat {
			margin: 0 0 1.25rem;
		}

		@media (min-width: 640px) {
			.room-modal__img :global(img) {
				height: 22rem;
			}
		}

		.room-card__img {
			aspect-ratio: 4 / 3;
			overflow: hidden;
		}

		.room-card__img :global(img) {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}

		.room-card h3 {
			margin: 1rem 1.1rem 0.3rem;
			font-size: 1.05rem;
			font-weight: 700;
		}

		.room-card__meta {
			margin: 0 1.1rem 0.9rem;
			font-size: 0.85rem;
			color: var(--cream-muted);
		}

		.room-card__price {
