			display: flex;
			align-items: center;
			gap: 0.5rem;
			font-size: 0.85rem;
			font-weight: 700;
			color: var(--accent);
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		.nearby-col__icon {
			flex-shrink: 0;
		}

		.nearby-col ul {
			list-style: none;
			margin: 0;
			padding: 0;
		}

		.nearby-col li {
			display: flex;
			justify-content: space-between;
			gap: 0.75rem;
			padding: 0.45rem 0;
			border-bottom: 1px solid var(--border-dark);
			font-size: 0.85rem;
			color: var(--cream-muted);
		}

		.nearby-col li a {
			color: var(--cream-muted);
			text-decoration: none;
		}

		.nearby-col li a:hover {
			color: var(--accent);
			text-decoration: underline;
		}

		.nearby-col li:last-child {
