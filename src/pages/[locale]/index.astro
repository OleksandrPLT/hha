		.category-row {
			display: grid;
			grid-template-columns: 8rem 1fr 2rem;
			align-items: center;
			gap: 0.7rem;
		}

		.category-row__label {
			font-size: 0.8rem;
			color: var(--cream-muted);
		}

		.category-row__bar {
			display: block;
			height: 0.35rem;
			border-radius: 999px;
			background: var(--surface-dark-2);
			overflow: hidden;
		}

		.category-row__fill {
			display: block;
			height: 100%;
			background: var(--accent);
			border-radius: 999px;
		}

		.category-row__score {
			font-size: 0.78rem;
			font-weight: 700;
			color: var(--cream);
			text-align: right;
		}

		.recent-guests-label {
			margin: 2rem 0 0.75rem;
			font-size: 0.75rem;
			font-weight: 700;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--muted);
		}

		.guest-carousel {
			position: relative;
		}

		.guest-carousel__row {
			position: relative;
		}

		.guest-list {
			list-style: none;
			margin: 0;
			padding: 0 0.25rem;
			display: flex;
			gap: 0.9rem;
			overflow-x: auto;
			scroll-snap-type: x proximity;
			scrollbar-width: none;
		}

		.guest-list::-webkit-scrollbar {
			display: none;
		}

		.guest-card {
			flex: 0 0 16rem;
			scroll-snap-align: start;
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			font-size: 0.82rem;
			color: var(--cream-muted);
			background: var(--surface-dark);
			border: 1px solid var(--border-dark);
			border-radius: 0.85rem;
			padding: 1rem 1.1rem;
		}

		.guest-card__top {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.5rem;
		}

		.guest-card__name {
			font-weight: 700;
			color: var(--cream);
		}

		.guest-card__score {
			font-size: 0.75rem;
			font-weight: 800;
			padding: 0.1rem 0.5rem;
			border-radius: 999px;
			background: var(--surface-dark-2);
			color: var(--cream-muted);
			flex-shrink: 0;
		}

		.guest-card.is-good .guest-card__score {
			background: rgba(52, 168, 83, 0.18);
			color: #7fd99a;
		}

		.guest-card.is-mid .guest-card__score {
			background: rgba(251, 188, 5, 0.18);
			color: #f0c14b;
		}

		.guest-card.is-low .guest-card__score {
			background: rgba(234, 67, 53, 0.18);
			color: #f28b82;
		}

		.guest-card__meta {
			margin: 0;
			font-size: 0.72rem;
			color: var(--muted);
		}

		.guest-card__title {
			margin: 0;
			font-weight: 600;
			color: var(--cream-muted);
			font-style: italic;
		}

		.guest-card__comment {
			margin: 0;
			font-size: 0.78rem;
			line-height: 1.5;
			white-space: pre-line;
			color: var(--cream-muted);
		}

		.guest-carousel__btn {
			position: absolute;
			top: 50%;
			transform: translateY(-50%);
			width: 2.1rem;
			height: 2.1rem;
			border-radius: 50%;
			border: 1px solid var(--border-dark);
			background: var(--bg-dark);
			color: var(--cream);
			display: flex;
			align-items: center;
			justify-content: center;
			cursor: pointer;
			box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
