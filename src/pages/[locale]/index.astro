			line-height: 1.6;
			border-top: 1px solid var(--border-dark);
			padding-top: 0.85rem;
		}

		/* Location */
		.location {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 3rem;
			align-items: center;
		}

		.location__details {
			margin: 1.5rem 0;
			display: grid;
			gap: 0.9rem;
