---
// SSR глобально ввімкнено (Фаза 2+ потребує його), але ця сторінка суто
// контентна — статика швидша й простіша, тож примусово prerender. (Під час
// тех-режиму з паролем цей та інші prerender=true файли тимчасово
// перемикаються на false скриптом scripts/build-maintenance.sh — Astro
// вимагає, щоб сам export був статичним літералом, імпорт змінної сюди не
// підходить, перевірено емпірично 2026-08-30.)
export const prerender = true;
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LanguageModal from '../../components/LanguageModal.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import AmenityIcon from '../../components/AmenityIcon.astro';
import { locales, htmlLang, type Locale } from '../../i18n/locales';
import { landing } from '../../i18n/landing';
import { amenities } from '../../i18n/amenities';
import { newsCopy } from '../../i18n/news';
import { newsImages } from '../../data/news-images';
import { guestReviews } from '../../data/guest-reviews';
import { bookingCategoryScores } from '../../data/booking-categories';
import { bookingCategoryLabels } from '../../i18n/booking-categories';
import { faq } from '../../i18n/faq';
import { nearby } from '../../data/nearby';
import { nearbyCopy } from '../../i18n/nearby';
import { amenityCategories, roomTypes } from '../../data/amenities';
import { property } from '../../data/property';
import { currency, rates, withVat, savingsPercent } from '../../data/pricing';

import heroExterior from '../../assets/property/hero-exterior.jpg';
import roomDouble from '../../assets/property/room-double.jpg';
import roomTwinA from '../../assets/property/room-twin-a.jpg';
import roomTwinB from '../../assets/property/room-twin-b.jpg';
import roomDorm from '../../assets/property/room-dorm.jpg';
import roomSingle from '../../assets/property/room-single.jpg';
import lounge from '../../assets/property/lounge.jpg';
import buffetTray from '../../assets/property/buffet-tray.jpg';
import buffetDish from '../../assets/property/buffet-dish.jpg';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const copy = landing[locale];
const amenitiesCopy = amenities[locale];
const newsC = newsCopy[locale];
const categoryLabels = bookingCategoryLabels[locale];
const faqCopy = faq[locale];
const nearbyC = nearbyCopy[locale];
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqCopy.items.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};
const title = `${property.brand} — ${property.propertyName}, ${property.city}`;

const latestNews = (await getCollection('news', (entry) => entry.data.locale === locale))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 2);
const newsDateFormatter = new Intl.DateTimeFormat(htmlLang[locale], { year: 'numeric', month: 'long', day: 'numeric' });
function newsSlugFor(id: string) {
	return id.replace(new RegExp(`-${locale}$`), '');
}

// Фото по типах номерів — ілюстративне зіставлення (реальні фото з об'єкта,
// але не прив'язані 1:1 до конкретної кімнати з довідки клієнта).
const roomPhotos: Record<string, ImageMetadata> = {
	family: roomDouble,
	single: roomSingle,
	dormBed: roomDorm,
	triple: roomTwinA,
	fourBed: roomTwinB,
};

const roomCards = roomTypes.map((room) => ({
	...room,
	...amenitiesCopy.rooms[room.id],
	img: roomPhotos[room.id],
	rate: rates[room.rateCategory],
}));

const schema = {
	'@context': 'https://schema.org',
	'@type': 'LodgingBusiness',
	name: property.propertyName,
	alternateName: property.brand,
	url: `${Astro.site}${locale}`,
	image: new URL(heroExterior.src, Astro.site).toString(),
	telephone: property.phoneE164,
	email: property.email,
	address: {
		'@type': 'PostalAddress',
		streetAddress: property.streetAddress,
		addressLocality: property.city,
		postalCode: property.postalCode,
		addressCountry: property.country,
	},
	sameAs: [property.bookingUrl],
	inLanguage: htmlLang[locale],
};
---

<BaseLayout locale={locale} title={title} description={copy.metaDescription} path="/" schema={schema}>
	<LanguageModal locale={locale} />
	<SiteHeader locale={locale} />

	<main>
		<!-- Hero -->
		<section class="hero">
			<Image src={heroExterior} alt="Hostel 3A building exterior in Maardu" class="hero__img" width={1920} loading="eager" fetchpriority="high" />
			<div class="hero__scrim"></div>
			<div class="hero__content">
				<p class="eyebrow eyebrow--dark">{copy.hero.eyebrow}</p>
				<h1>{copy.hero.heading}</h1>
				<p class="hero__subheading">{copy.hero.subheading}</p>
				<div class="hero__actions">
					<a class="btn btn--primary" href={property.bookingUrl} target="_blank" rel="noopener noreferrer">{copy.hero.ctaBook}</a>
					<a class="btn btn--ghost" href="#contact">{copy.hero.ctaContact}</a>
				</div>
			</div>
		</section>

		<!-- About -->
		<section id="about" class="section section--light">
			<div class="container about">
				<div class="about__text">
					<p class="eyebrow">{copy.about.eyebrow}</p>
					<h2>{copy.about.heading}</h2>
					<p class="body-text">{copy.about.body}</p>
				</div>
				<div class="about__image">
					<Image src={lounge} alt={copy.rooms.items.lounge.title} width={900} loading="lazy" />
				</div>
			</div>
		</section>

		<!-- Rooms + tariffs -->
		<section id="rooms" class="section section--dark">
			<div class="container">
				<p class="eyebrow eyebrow--dark">{copy.rooms.eyebrow}</p>
				<h2 class="heading--dark">{amenitiesCopy.roomsHeading}</h2>
				<p class="body-text body-text--dark section-subheading">{amenitiesCopy.roomsSubheading}</p>

				<div class="room-grid">
					{
						roomCards.map((room, i) => (
							<article class="room-card" data-room-index={i} role="button" tabindex="0" aria-haspopup="dialog" aria-label={room.title}>
								<div class="room-card__img">
									<Image src={room.img} alt={room.title} width={700} loading="lazy" />
								</div>
								<h3>{room.title}</h3>
								<p class="room-card__meta">
									{room.beds} · {room.guests}
								</p>
								<div class="room-card__price">
									<span class="price-amount">
										{currency}
										{room.rate.perNight.toFixed(2)}
									</span>
									<span class="price-unit">{copy.pricing.perDay}</span>
								</div>
								<p class="room-card__vat">
									{copy.pricing.vatIncluded} {currency}
									{withVat(room.rate.perNight).toFixed(2)}
								</p>
							</article>
						))
					}
				</div>

				<!-- Модалка з великим фото — відкривається кліком/Enter по картці номера. -->
				<div id="room-modal" class="room-modal" hidden>
					<div class="room-modal__scrim" data-room-modal-close></div>
					<div class="room-modal__dialog" role="dialog" aria-modal="true">
						<button type="button" class="room-modal__close" data-room-modal-close aria-label="Close">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
						</button>
						{
							roomCards.map((room, i) => (
								<div class="room-modal__panel" data-room-panel={i} hidden>
									<div class="room-modal__img">
										<Image src={room.img} alt={room.title} width={1100} loading="lazy" />
									</div>
									<div class="room-modal__body">
										<h3 id={`room-modal-title-${i}`}>{room.title}</h3>
										<p class="room-modal__meta">
											{room.beds} · {room.guests}
										</p>
										<div class="room-card__price">
											<span class="price-amount">
												{currency}
												{room.rate.perNight.toFixed(2)}
											</span>
											<span class="price-unit">{copy.pricing.perDay}</span>
										</div>
										<p class="room-card__vat">
											{copy.pricing.vatIncluded} {currency}
											{withVat(room.rate.perNight).toFixed(2)}
										</p>
										<a class="btn btn--primary" href={property.bookingUrl} target="_blank" rel="noopener noreferrer">
											{copy.hero.ctaBook}
										</a>
									</div>
								</div>
							))
						}
					</div>
				</div>

				<p class="rooms-vat-note">{copy.pricing.vatExcluded}</p>

				<!-- Пакетні тарифи (тиждень / 2 тижні / місяць) — за категоріями, не за
				     кожним типом номера окремо (обидва "shared"-типи номерів мають
				     однакову ціну на цій категорії). -->
				<div class="package-grid">
					{
						(
							[
								['shared', copy.pricing.categoryShared],
								['family', copy.pricing.categoryFamily],
							] as const
						).map(([key, label]) => {
							const rate = rates[key];
							return (
								<div class="package-card">
									<h3>{label}</h3>
									<dl>
										<div>
											<dt>{copy.pricing.colPerMonth}</dt>
											<dd>
												{currency}
												{rate.perMonth.toFixed(2)}
											</dd>
										</div>
										<div>
											<dt>{copy.pricing.colWeek}</dt>
											<dd>
												{currency}
												{rate.week.toFixed(2)}
												<span class="package-save">
													{copy.pricing.save} {savingsPercent(rate.perNight, rate.week, 7)}%
												</span>
											</dd>
										</div>
										<div>
											<dt>{copy.pricing.colTwoWeeks}</dt>
											<dd>
												{currency}
												{rate.twoWeeks.toFixed(2)}
												<span class="package-save">
													{copy.pricing.save} {savingsPercent(rate.perNight, rate.twoWeeks, 14)}%
												</span>
											</dd>
										</div>
									</dl>
								</div>
							);
						})
					}
				</div>

				<div class="terms-note">
					<strong>{copy.pricing.termsHeading}:</strong> {copy.pricing.termsPrepay} {copy.pricing.termsEarlyCheckout}
				</div>
			</div>
		</section>

		<script is:inline>
			(function () {
				var modal = document.getElementById('room-modal');
				if (!modal) return;
				var panels = modal.querySelectorAll('[data-room-panel]');
				var closers = modal.querySelectorAll('[data-room-modal-close]');
				var triggers = document.querySelectorAll('[data-room-index]');

				function openRoom(index) {
					panels.forEach(function (p) {
						p.hidden = p.getAttribute('data-room-panel') !== String(index);
					});
					modal.hidden = false;
					document.body.style.overflow = 'hidden';
				}

				function closeRoom() {
					modal.hidden = true;
					document.body.style.overflow = '';
				}

				triggers.forEach(function (el) {
					el.addEventListener('click', function () {
						openRoom(el.getAttribute('data-room-index'));
					});
					el.addEventListener('keydown', function (e) {
						if (e.key === 'Enter' || e.key === ' ') {
							e.preventDefault();
							openRoom(el.getAttribute('data-room-index'));
						}
					});
				});

				closers.forEach(function (el) {
					el.addEventListener('click', closeRoom);
				});

				document.addEventListener('keydown', function (e) {
					if (e.key === 'Escape' && !modal.hidden) closeRoom();
				});
			})();
		</script>

		<!-- Amenities -->
		<section id="amenities" class="section section--light">
			<div class="container">
				<p class="eyebrow">{amenitiesCopy.section.eyebrow}</p>
				<h2>{amenitiesCopy.section.heading}</h2>
				<p class="body-text section-subheading">{amenitiesCopy.section.subheading}</p>

				<div class="amenity-grid">
					{
						amenityCategories.map((cat) => (
							<div class="amenity-card">
								<h3>{amenitiesCopy.categories[cat.id as keyof typeof amenitiesCopy.categories]}</h3>
								<ul>
									{cat.items.map((item) => (
										<li class={item.badge === 'none' ? 'is-unavailable' : ''}>
											<span class="amenity-item__label">
												<AmenityIcon id={item.id} />
												<span class="amenity-item__name">{amenitiesCopy.items[item.id]}</span>
											</span>
											{item.hasValue ? (
												<span class="amenity-item__value">{amenitiesCopy.values[item.id]}</span>
											) : item.badge && item.badge !== 'none' ? (
												<span class={`amenity-badge amenity-badge--${item.badge}`}>{amenitiesCopy.badges[item.badge]}</span>
											) : null}
										</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Buffet -->
		<section id="buffet" class="section section--light">
			<div class="container buffet">
				<div class="buffet__text">
					<p class="eyebrow">{copy.buffet.eyebrow}</p>
					<h2>{copy.buffet.heading}</h2>
					<p class="body-text">{copy.buffet.body}</p>
					<p class="buffet__hours">{copy.buffet.hours}</p>
				</div>
				<div class="buffet__images">
					<Image src={buffetTray} alt="Pagari Buffet home-style dishes" width={600} loading="lazy" />
					<Image src={buffetDish} alt="Pagari Buffet plate" width={600} loading="lazy" />
				</div>
			</div>
		</section>

		<!-- Reviews -->
		<section class="section section--dark">
			<div class="container">
				<p class="eyebrow eyebrow--dark">{copy.reviews.eyebrow}</p>
				<h2 class="heading--dark">{copy.reviews.heading}</h2>
				<p class="body-text body-text--dark section-subheading">{copy.reviews.subheading}</p>

				<div class="review-cards">
					<a class="review-card" href={property.bookingUrl} target="_blank" rel="noopener noreferrer">
						<div class="review-card__top">
							<span class="review-card__brand">
								<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
									<rect width="18" height="18" rx="4" fill="#003580" />
									<path
										d="M6.2 4.2h3.55c1.55 0 2.55.78 2.55 2.05 0 .9-.5 1.5-1.15 1.78.85.28 1.45.98 1.45 1.98 0 1.4-1.1 2.17-2.7 2.17H6.2V4.2Zm3.35 3.35c.7 0 1.15-.38 1.15-.98 0-.6-.45-.95-1.15-.95H7.85v1.93h1.7Zm.2 3.4c.75 0 1.25-.4 1.25-1.05 0-.63-.5-1.03-1.25-1.03H7.85v2.08h1.9Z"
										fill="#fff"
									/>
								</svg>
								<span class="review-card__label">Booking.com</span>
							</span>
							<span class="review-card__score">
								{property.bookingScore}<span class="review-card__score-max">/10</span>
							</span>
						</div>
						<span class="review-card__count">{property.bookingReviewCount}+ reviews · {property.bookingSnapshotDate}</span>
						<span class="review-card__cta">{copy.reviews.bookingCta} →</span>
					</a>
					<a class="review-card" href={property.googleReviewsUrl} target="_blank" rel="noopener noreferrer">
						<div class="review-card__top">
							<span class="review-card__brand">
								<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
									<path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z" />
									<path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z" />
									<path fill="#FBBC05" d="M3.964 10.71c-.18-.54-.282-1.117-.282-1.71s.102-1.17.282-1.71V4.958H.957C.347 6.173 0 7.548 0 9s.348 2.827.957 4.042l3.007-2.332z" />
									<path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z" />
								</svg>
								<span class="review-card__label">Google</span>
							</span>
							<span class="review-card__score">
								{property.googleScore}<span class="review-card__score-max">/5</span>
							</span>
						</div>
						<span class="review-card__count">{property.googleReviewCount} reviews</span>
						<span class="review-card__cta">{copy.reviews.googleCta} →</span>
					</a>
				</div>

				<div class="category-scores">
					{
						Object.entries(bookingCategoryScores).map(([key, score]) => (
							<div class="category-row">
								<span class="category-row__label">{categoryLabels[key as keyof typeof categoryLabels]}</span>
								<span class="category-row__bar">
									<span class="category-row__fill" style={`width:${(score / 10) * 100}%`} />
								</span>
								<span class="category-row__score">{score.toFixed(1)}</span>
							</div>
						))
					}
				</div>

				<div class="guest-carousel">
					<p class="recent-guests-label">{copy.reviews.recentGuestsLabel}</p>
					<div class="guest-carousel__row">
						<ul class="guest-list" id="guest-list">
							{
								guestReviews.map((r) => (
									<li class={`guest-card ${r.score >= 8 ? 'is-good' : r.score >= 5 ? 'is-mid' : 'is-low'}`}>
										<div class="guest-card__top">
											<span class="guest-card__name">
												<span aria-hidden="true">{r.countryFlag}</span> {r.name}
											</span>
											<span class="guest-card__score">{r.score}</span>
										</div>
										<p class="guest-card__meta">
											{r.roomType} · {r.date}
										</p>
										{r.title && <p class="guest-card__title">“{r.title}”</p>}
										{r.comment && <p class="guest-card__comment">{r.comment}</p>}
									</li>
								))
							}
						</ul>
						<button type="button" class="guest-carousel__btn guest-carousel__btn--prev" data-guest-scroll="-1" aria-label="Previous">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
						</button>
						<button type="button" class="guest-carousel__btn guest-carousel__btn--next" data-guest-scroll="1" aria-label="Next">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
						</button>
					</div>
				</div>
			</div>

			<script is:inline>
				(function () {
					var list = document.getElementById('guest-list');
					if (!list) return;
					document.querySelectorAll('[data-guest-scroll]').forEach(function (btn) {
						btn.addEventListener('click', function () {
							var dir = parseInt(btn.getAttribute('data-guest-scroll'), 10);
							list.scrollBy({ left: dir * 280, behavior: 'smooth' });
						});
					});
				})();
			</script>
		</section>

		<!-- News -->
		{
			latestNews.length > 0 && (
				<section id="news" class="section section--light">
					<div class="container">
						<p class="eyebrow">{newsC.navLabel}</p>
						<h2>{newsC.heading}</h2>
						<p class="body-text section-subheading">{newsC.subheading}</p>

						<div class="news-grid">
							{latestNews.map((post) => (
								<a class="news-card" href={`/${locale}/news/${newsSlugFor(post.id)}`}>
									<div class="news-card__img">
										<Image src={newsImages[post.data.image]} alt={post.data.title} width={700} loading="lazy" />
									</div>
									<div class="news-card__body">
										<time datetime={post.data.date.toISOString()}>{newsDateFormatter.format(post.data.date)}</time>
										<h3>{post.data.title}</h3>
										<p>{post.data.excerpt}</p>
										<span class="read-more">{newsC.readMore} →</span>
									</div>
								</a>
							))}
						</div>

						<a class="btn btn--primary-dark news-all-link" href={`/${locale}/news`}>
							{newsC.navLabel} →
						</a>
					</div>
				</section>
			)
		}

		<!-- FAQ -->
		<section id="faq" class="section section--dark">
			<div class="container">
				<p class="eyebrow eyebrow--dark">{faqCopy.eyebrow}</p>
				<h2 class="heading--dark">{faqCopy.heading}</h2>
				<p class="body-text body-text--dark section-subheading">{faqCopy.subheading}</p>

				<div class="faq-list">
					{
						faqCopy.items.map((item) => (
							<details class="faq-item">
								<summary>
									{item.q}
									<svg class="faq-item__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
										<path d="M6 9l6 6 6-6" />
									</svg>
								</summary>
								<p>{item.a}</p>
							</details>
						))
					}
				</div>
			</div>
			<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
		</section>

		<!-- Location / Contact -->
		<section id="location" class="section section--light">
			<div class="container location" id="contact">
				<div class="location__text">
					<p class="eyebrow">{copy.location.eyebrow}</p>
					<h2>{copy.location.heading}</h2>
					<p class="body-text">{copy.location.body}</p>

					<dl class="location__details">
						<div>
							<dt>{copy.location.addressLabel}</dt>
							<dd>{property.streetAddress}, {property.city}, {property.countryName}</dd>
						</div>
						<div>
							<dt>{copy.location.phoneLabel}</dt>
							<dd><a href={`tel:${property.phoneE164}`}>{property.phoneDisplay}</a></dd>
						</div>
						<div>
							<dt>{copy.location.emailLabel}</dt>
							<dd><a href={`mailto:${property.email}`}>{property.email}</a></dd>
						</div>
					</dl>

					<a class="btn btn--primary-dark" href={property.mapLinkHref} target="_blank" rel="noopener noreferrer">{copy.location.mapCta}</a>
				</div>
				<div class="location__map">
					<iframe
						src={property.mapEmbedSrc}
						title="Map"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
					></iframe>
				</div>
			</div>
		</section>

		<!-- Nearby -->
		<section class="section section--dark">
			<div class="container">
				<p class="eyebrow eyebrow--dark">{nearbyC.eyebrow}</p>
				<h2 class="heading--dark">{nearbyC.heading}</h2>
				<p class="body-text body-text--dark section-subheading">{nearbyC.subheading}</p>

				<div class="nearby-grid">
					{
						(
							[
								['attractions', nearby.attractions],
								['food', nearby.food],
								['nature', nearby.nature],
								['transport', nearby.transport],
							] as const
						).map(([key, places]) => (
							<div class="nearby-col">
								<h3>
									<svg class="nearby-col__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										{key === 'attractions' && <path d="M3 21h18M5 21V10M19 21V10M5 10l7-6 7 6M9 10v11M15 10v11" />}
										{key === 'food' && (
											<>
												<path d="M4 9h13v6a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V9Z" />
												<path d="M17 11h1.5a2 2 0 0 1 0 4H17" />
											</>
										)}
										{key === 'nature' && <path d="M3 20l6-11 4 6 3-4 5 9H3Z" />}
										{key === 'transport' && (
											<>
												<rect x="3" y="6" width="18" height="10" rx="2" />
												<path d="M3 12h18" />
												<circle cx="7.5" cy="18.5" r="1.5" />
												<circle cx="16.5" cy="18.5" r="1.5" />
											</>
										)}
									</svg>
									{nearbyC.categories[key]}
								</h3>
								<ul>
									{places.map((p) => (
										<li>
											<a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(p.name + ', Estonia')}`} target="_blank" rel="noopener noreferrer">
												{p.name}
											</a>
											<span class="nearby-col__km">{p.km} km</span>
										</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
			</div>
		</section>
	</main>

	<SiteFooter locale={locale} />

	<style>
		:global(.hero__img) {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
