		.guest-carousel__btn:hover {
			border-color: var(--accent);
			color: var(--accent);
		}

		.guest-carousel__btn--prev {
			left: -0.6rem;
		}

		.guest-carousel__btn--next {
			right: -0.6rem;
		}

		@media (max-width: 640px) {
			.guest-carousel__btn {
				display: none;
			}
		}

		/* News — компактно: маленькі горизонтальні картки, не на весь екран */
		.news-grid {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			margin-bottom: 1.5rem;
		}

		.news-card {
			display: grid;
			grid-template-columns: 4.5rem 1fr;
			gap: 0.9rem;
			align-items: center;
			overflow: hidden;
			border: 1px solid var(--border-light);
			border-radius: 0.75rem;
			text-decoration: none;
			color: inherit;
			background: #fff;
			padding: 0.6rem;
			transition: border-color 0.15s ease;
		}

		.news-card:hover {
			border-color: var(--accent);
		}

		.news-card__img {
			aspect-ratio: 1 / 1;
			overflow: hidden;
			border-radius: 0.5rem;
		}

		.news-card__img :global(img) {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}

		.news-card__body {
			min-width: 0;
		}

		.news-card time {
			font-size: 0.7rem;
			color: var(--text-dark-muted);
			text-transform: uppercase;
			letter-spacing: 0.06em;
		}

		.news-card h3 {
			margin: 0.15rem 0 0.2rem;
			font-size: 0.95rem;
			font-weight: 700;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
