		}

		.location__details a:hover {
			color: var(--accent);
		}

		.location__map {
			border-radius: 1rem;
			overflow: hidden;
			border: 1px solid var(--border-light);
			aspect-ratio: 4 / 3;
		}

		.location__map iframe {
