---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LanguageModal from '../../components/LanguageModal.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { locales, htmlLang, type Locale } from '../../i18n/locales';
import { landing } from '../../i18n/landing';
import { property } from '../../data/property';

import heroExterior from '../../assets/property/hero-exterior.jpg';
import roomDouble from '../../assets/property/room-double.jpg';
import roomTwinA from '../../assets/property/room-twin-a.jpg';
import roomDorm from '../../assets/property/room-dorm.jpg';
import roomSingle from '../../assets/property/room-single.jpg';
import lounge from '../../assets/property/lounge.jpg';
import dining from '../../assets/property/dining.jpg';
import buffetTray from '../../assets/property/buffet-tray.jpg';
import buffetDish from '../../assets/property/buffet-dish.jpg';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const copy = landing[locale];
const title = `H&H apartments — ${property.propertyName}, ${property.city}`;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'LodgingBusiness',
	name: property.propertyName,
	alternateName: property.brand,
	url: `${Astro.site}${locale}`,
	image: new URL(heroExterior.src, Astro.site).toString(),
	telephone: property.phoneE164,
	email: property.email,
	address: {
		'@type': 'PostalAddress',
		streetAddress: property.streetAddress,
		addressLocality: property.city,
		postalCode: property.postalCode,
		addressCountry: property.country,
	},
	sameAs: [property.bookingUrl],
	inLanguage: htmlLang[locale],
};

const roomItems = [
	{ img: roomDouble, ...copy.rooms.items.double },
	{ img: roomTwinA, ...copy.rooms.items.twin },
	{ img: roomDorm, ...copy.rooms.items.dorm },
	{ img: roomSingle, ...copy.rooms.items.single },
	{ img: lounge, ...copy.rooms.items.lounge },
	{ img: dining, ...copy.rooms.items.dining },
];
---

<BaseLayout locale={locale} title={title} description={copy.metaDescription} path="/" schema={schema}>
	<LanguageModal locale={locale} />
	<SiteHeader locale={locale} />

	<main>
		<!-- Hero -->
		<section class="hero">
			<Image src={heroExterior} alt="Hostel 3A building exterior in Maardu" class="hero__img" width={1920} loading="eager" fetchpriority="high" />
			<div class="hero__scrim"></div>
			<div class="hero__content">
				<p class="eyebrow eyebrow--dark">{copy.hero.eyebrow}</p>
				<h1>{copy.hero.heading}</h1>
				<p class="hero__subheading">{copy.hero.subheading}</p>
				<div class="hero__actions">
					<a class="btn btn--primary" href={property.bookingUrl} target="_blank" rel="noopener noreferrer">{copy.hero.ctaBook}</a>
					<a class="btn btn--ghost" href="#contact">{copy.hero.ctaContact}</a>
				</div>
			</div>
		</section>

		<!-- About -->
		<section id="about" class="section section--light">
			<div class="container about">
				<div class="about__text">
					<p class="eyebrow">{copy.about.eyebrow}</p>
					<h2>{copy.about.heading}</h2>
					<p class="body-text">{copy.about.body}</p>
				</div>
				<div class="about__image">
					<Image src={lounge} alt={copy.rooms.items.lounge.title} width={900} loading="lazy" />
				</div>
			</div>
		</section>

		<!-- Rooms -->
		<section id="rooms" class="section section--dark">
			<div class="container">
				<p class="eyebrow eyebrow--dark">{copy.rooms.eyebrow}</p>
				<h2 class="heading--dark">{copy.rooms.heading}</h2>
				<p class="body-text body-text--dark section-subheading">{copy.rooms.subheading}</p>

				<div class="room-grid">
					{
						roomItems.map((room) => (
							<article class="room-card">
								<div class="room-card__img">
									<Image src={room.img} alt={room.title} width={700} loading="lazy" />
								</div>
								<h3>{room.title}</h3>
								<p>{room.caption}</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- Buffet -->
		<section id="buffet" class="section section--light">
			<div class="container buffet">
				<div class="buffet__text">
					<p class="eyebrow">{copy.buffet.eyebrow}</p>
					<h2>{copy.buffet.heading}</h2>
					<p class="body-text">{copy.buffet.body}</p>
					<p class="buffet__hours">{copy.buffet.hours}</p>
				</div>
				<div class="buffet__images">
					<Image src={buffetTray} alt="Pagari Buffet home-style dishes" width={600} loading="lazy" />
					<Image src={buffetDish} alt="Pagari Buffet plate" width={600} loading="lazy" />
				</div>
			</div>
		</section>

		<!-- Reviews -->
		<section class="section section--dark">
			<div class="container">
				<p class="eyebrow eyebrow--dark">{copy.reviews.eyebrow}</p>
				<h2 class="heading--dark">{copy.reviews.heading}</h2>
				<p class="body-text body-text--dark section-subheading">{copy.reviews.subheading}</p>

				<div class="review-cards">
					<a class="review-card" href={property.bookingUrl} target="_blank" rel="noopener noreferrer">
						<span class="review-card__label">Booking.com</span>
						<span class="review-card__cta">{copy.reviews.bookingCta} →</span>
					</a>
					<a class="review-card" href={property.mapLinkHref} target="_blank" rel="noopener noreferrer">
						<span class="review-card__label">Google</span>
						<span class="review-card__cta">{copy.reviews.googleCta} →</span>
					</a>
				</div>
			</div>
		</section>

		<!-- Location / Contact -->
		<section id="location" class="section section--light">
			<div class="container location" id="contact">
				<div class="location__text">
					<p class="eyebrow">{copy.location.eyebrow}</p>
					<h2>{copy.location.heading}</h2>
					<p class="body-text">{copy.location.body}</p>

					<dl class="location__details">
						<div>
							<dt>{copy.location.addressLabel}</dt>
							<dd>{property.streetAddress}, {property.city}, {property.countryName}</dd>
						</div>
						<div>
							<dt>{copy.location.phoneLabel}</dt>
							<dd><a href={`tel:${property.phoneE164}`}>{property.phoneDisplay}</a></dd>
						</div>
						<div>
							<dt>{copy.location.emailLabel}</dt>
							<dd><a href={`mailto:${property.email}`}>{property.email}</a></dd>
						</div>
					</dl>

					<a class="btn btn--primary-dark" href={property.mapLinkHref} target="_blank" rel="noopener noreferrer">{copy.location.mapCta}</a>
				</div>
				<div class="location__map">
					<iframe
						src={property.mapEmbedSrc}
						title="Map"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
					></iframe>
				</div>
			</div>
		</section>
	</main>

	<SiteFooter locale={locale} />

	<style>
		:global(.hero__img) {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.hero {
			position: relative;
			min-height: min(46rem, 92vh);
			display: flex;
			align-items: flex-end;
			overflow: hidden;
			background: var(--bg-dark);
		}

		.hero__scrim {
			position: absolute;
			inset: 0;
			background: linear-gradient(0deg, rgba(11, 13, 18, 0.92) 0%, rgba(11, 13, 18, 0.55) 45%, rgba(11, 13, 18, 0.25) 100%);
		}

		.hero__content {
			position: relative;
			max-width: 72rem;
			margin: 0 auto;
			padding: 3rem 1.25rem 3.5rem;
			color: var(--cream);
		}

		.hero h1 {
			margin: 0.4rem 0 1rem;
			font-size: clamp(2rem, 5vw, 3.25rem);
			font-weight: 800;
			letter-spacing: -0.01em;
			max-width: 40rem;
		}

		.hero__subheading {
			margin: 0 0 1.75rem;
			max-width: 34rem;
			font-size: clamp(1rem, 1.6vw, 1.15rem);
			color: var(--cream-muted);
			line-height: 1.55;
		}

		.hero__actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.85rem;
		}

		.eyebrow {
			margin: 0;
			font-size: 0.75rem;
			font-weight: 700;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			color: var(--text-dark-muted);
		}

		.eyebrow--dark {
			color: var(--accent);
		}

		.container {
			max-width: 72rem;
			margin: 0 auto;
			padding: 0 1.25rem;
		}

		.section {
			padding: clamp(3.5rem, 7vw, 6rem) 0;
		}

		.section--light {
			background: var(--bg-light);
			color: var(--text-dark);
		}

		.section--dark {
			background: var(--bg-dark);
			color: var(--cream);
		}

		.section--light h2 {
			color: var(--text-dark);
		}

		.heading--dark {
			color: var(--cream);
		}

		h2 {
			margin: 0.5rem 0 1rem;
			font-size: clamp(1.6rem, 3.2vw, 2.25rem);
			font-weight: 800;
			letter-spacing: -0.01em;
		}

		.body-text {
			margin: 0;
			line-height: 1.65;
			color: var(--text-dark-muted);
			max-width: 40rem;
		}

		.body-text--dark {
			color: var(--cream-muted);
		}

		.section-subheading {
			margin-bottom: 2.5rem;
		}

		.btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			padding: 0.8rem 1.4rem;
			border-radius: 0.6rem;
			font-weight: 700;
			font-size: 0.92rem;
			text-decoration: none;
			transition: filter 0.15s ease, background 0.15s ease, color 0.15s ease;
		}

		.btn--primary {
			background: var(--accent);
			color: #241a0c;
		}

		.btn--primary:hover {
			filter: brightness(1.08);
		}

		.btn--ghost {
			border: 1px solid rgba(245, 240, 230, 0.35);
			color: var(--cream);
		}

		.btn--ghost:hover {
			border-color: var(--accent);
			color: var(--accent);
		}

		.btn--primary-dark {
			background: var(--text-dark);
			color: var(--bg-light);
			margin-top: 0.5rem;
		}

		.btn--primary-dark:hover {
			filter: brightness(1.2);
		}

		/* About */
		.about {
			display: grid;
			grid-template-columns: 1.1fr 0.9fr;
			gap: 3rem;
			align-items: center;
		}

		.about__image :global(img) {
			width: 100%;
			height: 22rem;
			object-fit: cover;
			border-radius: 1rem;
			display: block;
		}

		/* Rooms */
		.room-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
			gap: 1.75rem;
		}

		.room-card {
			background: var(--surface-dark);
			border: 1px solid var(--border-dark);
			border-radius: 1rem;
			overflow: hidden;
		}

		.room-card__img {
			aspect-ratio: 4 / 3;
			overflow: hidden;
		}

		.room-card__img :global(img) {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}

		.room-card h3 {
			margin: 1rem 1.1rem 0.35rem;
			font-size: 1.05rem;
			font-weight: 700;
		}

		.room-card p {
			margin: 0 1.1rem 1.1rem;
			font-size: 0.88rem;
			line-height: 1.5;
			color: var(--cream-muted);
		}

		/* Buffet */
		.buffet {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 3rem;
			align-items: center;
		}

		.buffet__hours {
			display: inline-block;
			margin-top: 1rem;
			padding: 0.4rem 0.8rem;
			border-radius: 0.5rem;
			background: rgba(226, 182, 118, 0.18);
			color: #8a5a1c;
			font-weight: 700;
			font-size: 0.85rem;
		}

		.buffet__images {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 1rem;
		}

		.buffet__images :global(img) {
			width: 100%;
			height: 12rem;
			object-fit: cover;
			border-radius: 0.85rem;
			display: block;
		}

		/* Reviews */
		.review-cards {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
			gap: 1.25rem;
		}

		.review-card {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			padding: 1.5rem;
			border-radius: 1rem;
			border: 1px solid var(--border-dark);
			background: var(--surface-dark);
			text-decoration: none;
			transition: border-color 0.15s ease;
		}

		.review-card:hover {
			border-color: var(--accent);
		}

		.review-card__label {
			font-weight: 700;
			color: var(--cream);
			font-size: 1.05rem;
		}

		.review-card__cta {
			color: var(--accent);
			font-size: 0.9rem;
			font-weight: 600;
		}

		/* Location */
		.location {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 3rem;
			align-items: center;
		}

		.location__details {
			margin: 1.5rem 0;
			display: grid;
			gap: 0.9rem;
		}

		.location__details dt {
			font-size: 0.75rem;
			text-transform: uppercase;
			letter-spacing: 0.08em;
			color: var(--text-dark-muted);
		}

		.location__details dd {
			margin: 0.15rem 0 0;
			font-weight: 600;
		}

		.location__details a {
			color: var(--text-dark);
			text-decoration: none;
		}

		.location__details a:hover {
			color: var(--accent);
		}

		.location__map {
			border-radius: 1rem;
			overflow: hidden;
			border: 1px solid var(--border-light);
			aspect-ratio: 4 / 3;
		}

		.location__map iframe {
			width: 100%;
			height: 100%;
			border: 0;
			display: block;
		}

		@media (max-width: 860px) {
			.about,
			.buffet,
			.location {
				grid-template-columns: 1fr;
			}

			.about__image {
				order: -1;
			}
		}
	</style>
</BaseLayout>
