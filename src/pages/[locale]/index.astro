			border-radius: 0.4rem;
		}

		.review-card__score-max {
			font-size: 0.7rem;
			font-weight: 600;
			opacity: 0.75;
		}

		.review-card__count {
			font-size: 0.78rem;
			color: var(--muted);
		}

		.review-card__cta {
			color: var(--accent);
			font-size: 0.9rem;
			font-weight: 600;
		}

		.category-scores {
			margin-top: 2rem;
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
			gap: 0.6rem 2rem;
